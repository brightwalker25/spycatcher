#!/usr/bin/env bash
# Periodic security scans. Driven by security-scan@.service and the
# security-scan-*.timer units; safe to run by hand for a one-off check.
#
#   security-scan arch-audit   known CVEs in installed packages
#   security-scan gitleaks     secrets and private identifiers in SCAN_ROOT repos
#   security-scan lynis        full system hardening audit
#   security-scan aide         file-integrity check of system files
#   security-scan rkhunter     rootkit and suspicious-file check
#   security-scan models       malicious-pickle check of AI model files
#
# `security-report` reads the logs these write and grades them.

set -uo pipefail

MODE="${1:-}"
case "$MODE" in
  arch-audit | lynis | gitleaks | aide | rkhunter | models) ;;
  *)
    echo "usage: ${0##*/} <arch-audit|lynis|gitleaks|aide|rkhunter|models>" >&2
    exit 2
    ;;
esac

: "${SCAN_CONF:=/etc/security-scan/scan.conf}"
: "${LOG_DIR:=/var/log/security-scan}"
: "${GITLEAKS_CONFIG:=/etc/security-scan/gitleaks.toml}"
: "${AIDE_CONFIG:=/etc/security-scan/aide.conf}"
# How long the AIDE check waits for a running pacman to finish, in seconds.
: "${PACMAN_WAIT:=600}"
case "$PACMAN_WAIT" in '' | *[!0-9]*) PACMAN_WAIT=600 ;; esac
KEEP=12

# Values set in the environment win over scan.conf, so a one-off run can
# point somewhere else without editing the installed file.
env_user=${DESKTOP_USER-}
env_scan_root=${SCAN_ROOT-}
env_model_roots=${MODEL_ROOTS-}

# scan.conf is sourced into a script that runs as root. A copy that anyone
# but root can write would let that user run code as root, so it is skipped.
conf_error=""
if [ -e "$SCAN_CONF" ]; then
  if [ "$(id -u)" -eq 0 ] &&
    { [ "$(stat -c %u "$SCAN_CONF")" != 0 ] || [ -n "$(find "$SCAN_CONF" -perm /022)" ]; }; then
    conf_error="${SCAN_CONF} is not owned by root or is writable by others; ignored"
  else
    # shellcheck source=/dev/null
    . "$SCAN_CONF"
  fi
fi

DESKTOP_USER=${env_user:-${DESKTOP_USER:-}}
user_home=""
if [ -n "$DESKTOP_USER" ]; then
  user_home=$(getent passwd "$DESKTOP_USER" | cut -d: -f6)
fi
SCAN_ROOT=${env_scan_root:-${SCAN_ROOT:-${user_home:+${user_home}/Work}}}
MODEL_ROOTS=${env_model_roots:-${MODEL_ROOTS:-${user_home:+${user_home}/.cache/huggingface}}}

# Guessing the desktop user (first uid over 1000, owner of a session) picks
# the wrong account on a shared machine and would scan and notify the wrong
# person. Stop instead, and leave a log that the report shows as an error.
if [ -z "$DESKTOP_USER" ] || [ -z "$user_home" ]; then
  install -d -m 0750 "$LOG_DIR"
  LOG="$LOG_DIR/${MODE}-$(date +%Y%m%d-%H%M%S).log"
  {
    echo "=== ${MODE} run at $(date -Is) ==="
    [ -n "$conf_error" ] && echo "!! ${conf_error}"
    if [ -z "$DESKTOP_USER" ]; then
      echo "!! DESKTOP_USER is not set. Set it in ${SCAN_CONF} or the environment."
    else
      echo "!! DESKTOP_USER=${DESKTOP_USER} is not a user on this system."
    fi
    echo "summary: error, desktop user not configured"
  } >>"$LOG"
  echo "${0##*/}: desktop user not configured, see ${LOG}" >&2
  exit 1
fi

# The logs name repositories, files and findings, and the report reads them
# as the desktop user, so they are shared with the desktop user's own group
# and no one else. The installer refuses a machine without such a group, but
# groups can change after it ran, so the same test is made on every run: a
# group with the user's name that is their primary group and the only group
# with its GID, with no other member in /etc/group or /etc/gshadow, that no
# other account has as its primary group, on a machine that looks up
# accounts and groups only in the local files and systemd. Without one, the
# logs stay root's alone and the report cannot read them.
NSSWITCH=/etc/nsswitch.conf
GSHADOW=/etc/gshadow
only_member() {
  case ",$1," in ,, | ",${DESKTOP_USER},") return 0 ;; esac
  return 1
}
private_group() {
  local gid grp line src srcs gs
  # read -a splits on blanks without expanding [NOTFOUND=return] as a glob.
  while read -r line; do
    read -ra srcs <<<"$line"
    for src in "${srcs[@]}"; do
      case "$src" in
        files | systemd | \[*\]) ;;
        *) return 1 ;;
      esac
    done
  done < <(awk -F: '$1 ~ /^[ \t]*(passwd|group)[ \t]*$/ { sub(/#.*/, "", $2); print $2 }' "$NSSWITCH" 2>/dev/null)
  gid=$(getent passwd "$DESKTOP_USER" | cut -d: -f4)
  grp=$(getent group "$DESKTOP_USER") || return 1
  [ -n "$gid" ] && [ "$(printf '%s' "$grp" | cut -d: -f3)" = "$gid" ] || return 1
  only_member "$(printf '%s' "$grp" | cut -d: -f4)" || return 1
  [ "$(getent group | awk -F: -v g="$gid" '$3 == g' | wc -l)" -eq 1 ] || return 1
  [ -z "$(getent passwd | awk -F: -v g="$gid" -v u="$DESKTOP_USER" '$4 == g && $1 != u')" ] || return 1
  [ -e "$GSHADOW" ] || return 0
  gs=$(awk -F: -v n="$DESKTOP_USER" '$1 == n { print $4 }' "$GSHADOW") || return 1
  only_member "$gs"
}

LOG_GROUP=""
if [ "$(id -u)" -eq 0 ]; then
  if private_group; then
    LOG_GROUP=$DESKTOP_USER
    install -d -m 0750 -o root -g "$LOG_GROUP" "$LOG_DIR"
  else
    install -d -m 0700 -o root -g root "$LOG_DIR"
  fi
else
  install -d -m 0750 "$LOG_DIR"
fi
LOG="$LOG_DIR/${MODE}-$(date +%Y%m%d-%H%M%S).log"
if [ "$(id -u)" -eq 0 ] && [ -z "$LOG_GROUP" ]; then
  echo "${0##*/}: ${DESKTOP_USER} has no group of their own, so ${LOG_DIR} is kept for root alone and the report cannot read it" >&2
fi

log() { printf '%s\n' "$*" >>"$LOG"; }

# What the scanning tools print can quote text an attacker chose: a pickle
# file's import names, file names, package output. Copied into the log as it
# is, a line of it could pass for one the scan writes, such as a forged
# "summary:" or "!!" line, which the report trusts. So tool output reaches
# the log only through log_tool, which shows control characters as "?" and
# starts every line with "| ". The scan's own lines never start that way.
log_tool() { LC_ALL=C sed -e 's/[[:cntrl:]]/?/g' -e 's/^/| /' >>"$LOG"; }
# Python runs, for security-report's checks and the browser policy check,
# with nothing from the environment but PATH, which systemd or sudo sets for
# root, and the C locale, so no variable such as GCONV_PATH or
# GIO_EXTRA_MODULES can steer what a check runs or builds.
py() { env -i PATH="$PATH" LC_ALL=C python3 -I "$@"; }

# A name from the file system, such as a repository folder, for a line the
# scan writes itself: control characters, a new line among them, become "?".
clean() { printf '%s' "${1//[[:cntrl:]]/?}"; }

# True for a path inside the desktop user's home folder. An external command
# given such a path shows it (a private key's file name, say) to every local
# user through the process list, so these paths are only ever handled with
# shell builtins. A home folder of / would match everything, so it never does.
home_prefix=${user_home%/}
in_home() {
  [ -n "$home_prefix" ] || return 1
  case "$1" in
    "$home_prefix" | "$home_prefix"/*) return 0 ;;
  esac
  return 1
}

# Notification text as markup-safe text. Many notification daemons read the
# body, and some the title, as markup, where "<img src=...>" would make the
# desktop fetch a URL and "&" can break the whole message, so &, < and > are
# written as entities. The quotes keep bash 5.2's patsub_replacement from
# reading "&" in the replacement as the matched text.
markup() {
  local s=${1//'&'/'&amp;'}
  s=${s//'<'/'&lt;'}
  printf '%s' "${s//'>'/'&gt;'}"
}

# Findings that only reach the journal are findings nobody reads, so speak to
# the graphical session when there is one. Silently skipped on a headless boot;
# the log is still written either way.
notify() {
  local urgency="$1" title="$2" body="$3" uid bus
  uid=$(id -u "$DESKTOP_USER" 2>/dev/null) || return 0
  bus="/run/user/${uid}/bus"
  [ -S "$bus" ] || return 0
  runuser -u "$DESKTOP_USER" -- \
    env "DBUS_SESSION_BUS_ADDRESS=unix:path=${bus}" \
    notify-send -a "Security scan" -u "$urgency" "$(markup "$title")" "$(markup "$body")" \
    2>/dev/null || true
}

# Keep the last $KEEP logs per mode. Left to the scanner rather than logrotate
# so the whole thing stays in one file.
prune() {
  local old keep="" bin
  old=$(ls -1t "$LOG_DIR/${MODE}-"*.log 2>/dev/null | tail -n +$((KEEP + 1)))
  # An AIDE log that still holds a red nobody has acknowledged is kept, so
  # a red never ages out unseen. If the report cannot say, nothing goes.
  if [ "$MODE" = aide ] && [ -n "$old" ]; then
    bin="$(dirname -- "$(readlink -f -- "$0")")/security-report"
    if ! keep=$(env -i PATH="$PATH" LC_ALL=C LOG_DIR="$LOG_DIR" python3 -I "$bin" --keep-logs 2>&1); then
      log "!! could not tell which old logs hold an open red, so none were removed"
      return 0
    fi
  fi
  [ -n "$old" ] && printf '%s\n' "$old" | grep -vxF -e "$keep" -e "" | xargs -r rm -f
  return 0
}

log "=== ${MODE} run at $(date -Is) ==="
[ -n "$conf_error" ] && log "!! ${conf_error}"

case "$MODE" in

arch-audit)
  # Needs the network to reach the Arch security tracker. Offline is a skip,
  # not a finding: the timer is Persistent, so a missed run catches up.
  if ! out=$(arch-audit --color=never 2>&1); then
    log "arch-audit failed (offline?), skipping this run:"
    printf '%s\n' "$out" | log_tool
    # security-report ignores skipped runs, so the last real result stays in
    # force and a long offline stretch shows up as a stale scan.
    log "summary: skipped, offline"
    prune
    exit 0
  fi
  printf '%s\n' "$out" | log_tool

  # --upgradable lists only what a pacman -Syu would actually fix.
  fixable=$(arch-audit --quiet --upgradable --color=never 2>/dev/null | grep -c . || true)
  total=$(printf '%s\n' "$out" | grep -c 'is affected by' || true)

  log ""
  log "summary: ${total} affected package(s), ${fixable} fixable by upgrade"

  if [ "${fixable:-0}" -gt 0 ]; then
    notify critical "Vulnerable packages: ${fixable} fixable" \
      "${total} affected, ${fixable} fixed by an upgrade. Run: sudo pacman -Syu"
  elif [ "${total:-0}" -gt 0 ]; then
    notify normal "Vulnerable packages: ${total}" \
      "No upstream fix available yet. See ${LOG}"
  fi
  ;;

gitleaks)
  # Working tree only. History is scanned by the pre-commit path and by an
  # explicit --history run; a timer that re-reports long-published commits
  # every week trains you to ignore it.
  findings=0
  repos=0
  flagged=0

  # The scan runs from inside each repository, so a relative path given in
  # the environment must be resolved first.
  GITLEAKS_CONFIG=$(realpath -m -- "$GITLEAKS_CONFIG")
  # Without its config gitleaks fails on every repo; say why once.
  if [ ! -f "$GITLEAKS_CONFIG" ] || [ ! -r "$GITLEAKS_CONFIG" ]; then
    log "!! gitleaks config ${GITLEAKS_CONFIG} is missing or unreadable"
  fi

  # gitleaks renamed its scan verbs at 8.19: "dir" replaced "detect --no-git".
  # Pick whichever this build understands so a package upgrade can't quietly
  # turn every run into a usage error.
  if gitleaks dir --help >/dev/null 2>&1; then
    gl_scan() { gitleaks dir "$1" "${@:2}"; }
  else
    gl_scan() { gitleaks detect --no-git --source "$1" "${@:2}"; }
  fi

  while IFS= read -r gitdir; do
    # Parameter expansion, not dirname: an external command would show the
    # path in the process list.
    repo=${gitdir%/.git}
    repos=$((repos + 1))
    report=$(mktemp)

    # Scan from inside the repo, so its path never appears in gitleaks'
    # command line, which any local user can read in the process list.
    # gitleaks exits 1 both for leaks and for fatal errors such as a missing
    # config, so leaks are given exit 3 and a 1 means the scan failed.
    (cd "$repo" 2>/dev/null || exit 2; gl_scan . \
      --config "$GITLEAKS_CONFIG" \
      --exit-code 3 \
      --report-format json \
      --report-path "$report" \
      --redact \
      --no-banner) 2>&1 | log_tool
    rc=${PIPESTATUS[0]}

    n=""
    if [ -s "$report" ]; then
      n=$(grep -c '"RuleID"' "$report" 2>/dev/null || true)
    fi

    n=${n:-0}

    if [ "$rc" -ne 0 ] && [ "$rc" -ne 3 ]; then
      log "!! gitleaks errored on $(clean "$repo") (exit ${rc})"
    fi

    if [ "$n" -gt 0 ]; then
      findings=$((findings + n))
      flagged=$((flagged + 1))
      log ""
      log "--- $(clean "$repo"): ${n} finding(s) ---"
      log_tool <"$report"
    fi
    rm -f "$report"
  done < <(find "$SCAN_ROOT" -maxdepth 3 -type d -name .git 2>/dev/null)

  log ""
  log "summary: ${findings} finding(s) across ${repos} repo(s)"

  if [ "$findings" -gt 0 ]; then
    # Counts only. notify-send takes the body as an argument, which any
    # local user can read in the process list, so repo names stay in the log.
    notify critical "Secrets found in ${flagged} of ${repos} repo(s)" \
      "${findings} finding(s). See ${LOG}"
  fi
  ;;

lynis)
  # --cronjob implies --quiet --no-colors and a non-interactive exit.
  lynis audit system --cronjob 2>&1 | log_tool

  report=/var/log/lynis-report.dat
  if [ -r "$report" ]; then
    # lynis writes its report 0640 root:root; re-lay it down so the desktop
    # user can read its own audit without sudo.
    if [ -n "$LOG_GROUP" ]; then
      install -m 0640 -g "$LOG_GROUP" "$report" "${LOG%.log}-report.dat"
    elif [ "$(id -u)" -eq 0 ]; then
      install -m 0600 -g root "$report" "${LOG%.log}-report.dat"
    else
      cp -f "$report" "${LOG%.log}-report.dat"
    fi
    index=$(awk -F= '/^hardening_index=[0-9]+$/{print $2}' "$report" | tail -1)
    warnings=$(grep -c '^warning\[\]=' "$report" || true)
    suggestions=$(grep -c '^suggestion\[\]=' "$report" || true)

    log ""
    log "summary: hardening index ${index:-?}, ${warnings} warning(s), ${suggestions} suggestion(s)"
    log ""
    log "--- warnings ---"
    grep '^warning\[\]=' "$report" 2>/dev/null | log_tool

    if [ "${warnings:-0}" -gt 0 ]; then
      notify normal "Lynis: ${warnings} warning(s)" \
        "Hardening index ${index:-?}/100. See ${LOG}"
    fi
  else
    log "lynis produced no report at ${report}"
  fi
  ;;

aide)
  # Check against the baseline, explain each change, then re-baseline so the
  # next run only reports what is new. The previous baseline is kept as
  # aide.db.prev.gz; the log keeps every finding for the weekly report.
  db=/var/lib/aide/aide.db.gz
  # aide is in the AUR only, so the installer cannot add it as root. Report
  # its absence as an error rather than as a clean run.
  if ! command -v aide >/dev/null 2>&1; then
    log "aide is not installed. Install it from the AUR, for example: yay -S aide"
    log "summary: error, aide not installed"
    prune
    exit 0
  fi
  if [ ! -s "$db" ]; then
    log "no baseline at ${db}; creating one, nothing to compare this run"
    aide --init --no-progress --no-color -c "$AIDE_CONFIG" >/dev/null 2>>"$LOG" &&
      mv -f /var/lib/aide/aide.db.new.gz "$db"
    log "summary: baseline created"
    prune
    exit 0
  fi

  # A package update rewrites thousands of files in seconds. Read by AIDE, or
  # looked up in pacman's database, in the middle of one, the system is
  # neither its old self nor its new one, and pacman itself can fail while
  # its own libraries are being replaced, which made package files read as
  # unpackaged reds. So the check waits for pacman to finish, by default up
  # to ten minutes (PACMAN_WAIT), and a check that a package update
  # overlapped is set aside whole: its summary says "skipped", which the
  # report does not grade, and the baseline is kept, so the next check
  # reports every change in full.
  pacman_lock=/var/lib/pacman/db.lck
  limine_new="" work=""
  # pacman, and anything else built on libalpm, holds its lock file open for
  # as long as it runs. A lock file nobody holds is left over from a pacman
  # that crashed or was killed; it does not stop pacman -Ql or -Qkk, which
  # only read, so the check goes ahead and says so.
  pacman_busy() {
    [ -e "$pacman_lock" ] &&
      [ -n "$(find /proc/[0-9]*/fd -lname "$pacman_lock" -print -quit 2>/dev/null)" ]
  }
  set_aside() {
    log "${1}, so this check was set aside and the baseline kept. The next check reports these changes."
    log "summary: skipped, ${2}"
    rm -f /var/lib/aide/aide.db.new.gz
    [ -n "$limine_new" ] && rm -f "$limine_new"
    [ -n "$work" ] && rm -rf "$work"
    prune
    exit 0
  }
  waited=0
  while pacman_busy && [ "$waited" -lt "$PACMAN_WAIT" ]; do
    sleep 10
    waited=$((waited + 10))
  done
  pacman_busy &&
    set_aside "pacman was still running after waiting ${PACMAN_WAIT} seconds (it holds ${pacman_lock})" \
      "package update in progress"
  [ -e "$pacman_lock" ] &&
    log "${pacman_lock} is left over from a pacman that is no longer running; checking anyway. Remove it once no package manager is open."
  pacman_size=$(stat -c %s /var/log/pacman.log 2>/dev/null || echo 0)
  pacman_ran() {
    local size
    pacman_busy && return 0
    size=$(stat -c %s /var/log/pacman.log 2>/dev/null || echo 0)
    [ "$size" -lt "$pacman_size" ] && return 0
    # grep -c reads to the end; grep -q would stop early and, under
    # pipefail, the killed tail would make a match read as none.
    [ "$(tail -c +"$((pacman_size + 1))" /var/log/pacman.log 2>/dev/null |
      grep -c '\[ALPM\] transaction started')" -gt 0 ]
  }

  # Every change is graded from a few lookups made once for the whole run,
  # not once per file: one pacman -Ql for who owns each path, one pacman -Qkk
  # over the packages that own a changed file, and one call of
  # security-report for the rarer explanations. A kernel update changes tens
  # of thousands of files, and asking pacman about each in turn took longer
  # than the scan's time limit. The lists live in a private folder of the
  # scan's own temporary directory and are never put on a command line.
  # pacman's messages are matched as English text, so it runs in the C locale.
  work=$(mktemp -d) || {
    log "!! could not make a temporary folder; nothing was graded and the baseline was kept"
    log "summary: error, no temporary folder"
    prune
    exit 0
  }
  # Stops without grading anything and keeps the baseline, so the next run
  # sees the same changes.
  cannot_grade() {
    log "!! ${1}; nothing was graded and the baseline was kept"
    log "summary: error, ${2}"
    rm -f /var/lib/aide/aide.db.new.gz
    [ -n "$limine_new" ] && rm -f "$limine_new"
    rm -rf "$work"
    notify critical "File integrity check failed" "${2}. See ${LOG}"
    prune
    exit 0
  }

  # Every installed package's file list, taken just before AIDE reads the
  # files, so it describes the same system. It grades this run, and is kept
  # with the new baseline, so that the next run can tell which removed files
  # belonged to a package that pacman has since upgraded or removed.
  owners_ref=/var/lib/security-scan/owners.gz
  {
    LC_ALL=C pacman -Ql 2>/dev/null
    echo "$?" >"$work/ql.rc"
  } | gzip -1 >"$work/owners.gz"
  [ "$(cat "$work/ql.rc" 2>/dev/null)" = 0 ] ||
    cannot_grade "pacman could not list the files of installed packages" "pacman -Ql failed"

  # A copy of limine.conf taken before AIDE reads /boot. It becomes the
  # trusted copy that limine_snapshot_change compares against, but only when
  # this run finds nothing red under /boot and the file has not changed since.
  limine_ref=/var/lib/security-scan/limine.conf
  if [ -f /boot/limine.conf ]; then
    install -d -m 0700 /var/lib/security-scan
    limine_new=$(mktemp /var/lib/security-scan/limine.conf.XXXXXX) &&
      cp -f /boot/limine.conf "$limine_new" || limine_new=""
  fi

  # A new database left by an earlier run that failed must not be taken for
  # this run's.
  rm -f /var/lib/aide/aide.db.new.gz
  out=$(aide --update --no-progress --no-color -c "$AIDE_CONFIG" 2>&1)
  rc=$?
  # Exit codes 1, 2 and 4 are bits for added, removed and changed entries;
  # 14 and up are real errors.
  if [ "$rc" -ge 14 ]; then
    log "!! aide failed (exit ${rc}):"
    printf '%s\n' "$out" | log_tool
    log "summary: error"
    [ -n "$limine_new" ] && rm -f "$limine_new"
    rm -rf "$work"
    notify critical "File integrity check failed" "aide exit ${rc}. See ${LOG}"
    prune
    exit 0
  fi
  pacman_ran && set_aside "pacman installed or removed packages while AIDE read the files" \
    "package update during the check"

  # Package updates are the normal reason a system file changes. A file that
  # pacman owns and still verifies byte-for-byte is explained; anything else
  # under a code path is not. Changed config and user persistence files are
  # listed for a human to confirm.
  # A reinstall or downgrade runs the same hooks as an upgrade, so it counts
  # too; leaving it out made a keyring reinstall's boot menu rewrite red.
  # security-report applies the same rule to RED lines logged before this.
  # The window is logged so security-report can re-read a red line against
  # exactly the transactions this count saw.
  last_run=$(stat -c %Y "$db" 2>/dev/null || echo 0)
  since_ts=$(date -d "@${last_run}" '+%Y-%m-%dT%H:%M:%S')
  log "pacman window: $(date -d "@${last_run}" -Is) to $(date -Is)"
  # The version of the grading rules below. The weekly report re-applies its
  # own copies of the rules only to red lines of logs from earlier versions.
  # 4 since 0.3.0: an unpackaged file in a system code path written while
  # pacman ran is amber, not red.
  log "graded by security-scan rules 4"
  pacman_since=$(awk -v t="$since_ts" \
    '/\[ALPM\] (upgraded|installed|removed|reinstalled|downgraded) / { ts=substr($1,2,19); if (ts >= t) n++ } END { print n+0 }' \
    /var/log/pacman.log 2>/dev/null)
  # The packages pacman upgraded, removed, reinstalled or downgraded in that
  # window, any of which may have taken files away.
  declare -A pkg_changed=()
  while IFS= read -r p; do
    pkg_changed[$p]=1
  done < <(awk -v t="$since_ts" \
    '/\[ALPM\] (upgraded|removed|reinstalled|downgraded) / { ts=substr($1,2,19); if (ts >= t) print $4 }' \
    /var/log/pacman.log 2>/dev/null)

  # Each change as "TYPE<tab>WHAT<tab>PATH". TYPE is the first letter of
  # AIDE's summary (f, d, l and so on), the type of the entry now; a folder
  # is told by that letter, never by looking at the path, which would follow
  # a symlink put where a folder was. WHAT is added, removed or changed. AIDE
  # writes a backslash or a control character in a name as \ooo (octal);
  # names are decoded here. A name that then holds a control character, such
  # as a new line, cannot be handled safely line by line: it is red, logged
  # as AIDE wrote it.
  aide_name() {
    local s=$1 out="" ch
    while [[ $s == *\\* ]]; do
      out+=${s%%\\*}
      s=${s#*\\}
      if [[ $s =~ ^[0-7]{3} ]]; then
        printf -v ch '%b' "\\0${s:0:3}"
        out+=$ch
        s=${s:3}
      else
        out+=\\
      fi
    done
    REPLY=$out$s
  }
  bad_names=0
  while IFS= read -r line; do
    attr=${line%%: *}
    raw=${line#*: }
    case "$attr" in
      ?++*) what=added ;;
      ?--*) what=removed ;;
      *) what=changed ;;
    esac
    aide_name "$raw"
    if [[ $REPLY == *[[:cntrl:]]* ]] || [ -z "$REPLY" ]; then
      log "RED ${what} ${raw} (name holds control characters, shown as AIDE wrote it; check it by hand)"
      bad_names=$((bad_names + 1))
      continue
    fi
    printf '%s\t%s\t%s\n' "${attr:0:1}" "$what" "$REPLY"
  done < <(printf '%s\n' "$out" | grep -E '^[fdlbcpsDP!][^:]*: /') >"$work/lines"
  # Home folder paths have no package and must not reach pacman's output
  # matching either, so they are left out of the lookups.
  while IFS=$'\t' read -r type what path; do
    in_home "$path" || printf '%s\n' "$path"
  done <"$work/lines" >"$work/paths"

  # Who owns each changed path, now and, for the files that were removed, at
  # the last check, matched in awk against a list of every package file.
  # pacman lists folders with a trailing slash; AIDE does not. The first
  # package listed wins, as with pacman -Qqo | head -1.
  owners_of() {
    zcat -- "$1" 2>/dev/null | awk -v list="$work/paths" '
      BEGIN { while ((getline l < list) > 0) want[l] = 1 }
      {
        i = index($0, " ")
        if (!i) next
        pkg = substr($0, 1, i - 1); p = substr($0, i + 1)
        dir = (p ~ /\/$/) ? "d" : "-"
        if (p != "/") sub(/\/$/, "", p)
        if ((p in want) && !(p in seen)) { seen[p] = 1; print pkg "\t" dir "\t" p }
      }'
  }
  # owner_dir marks the paths the package lists as a folder.
  declare -A owner_of=() owner_dir=() was_owner_of=()
  while IFS=$'\t' read -r o d p; do
    owner_of[$p]=$o
    [ "$d" = d ] && owner_dir[$p]=1
  done < <(owners_of "$work/owners.gz")
  if [ -s "$owners_ref" ]; then
    while IFS=$'\t' read -r o d p; do
      was_owner_of[$p]=$o
    done < <(owners_of "$owners_ref")
  fi

  # Which packages own a file that is still there, and which changed files no
  # package owns. The second list goes to security-report below.
  declare -A need=()
  : >"$work/explain"
  # Folders count too: a folder's mode, owner or type is what AIDE watches
  # on it, and pacman -Qkk checks those for the folders a package lists.
  while IFS=$'\t' read -r type what path; do
    [ "$what" = removed ] && continue
    in_home "$path" && continue
    if [ -n "${owner_of[$path]-}" ]; then
      need[${owner_of[$path]}]=1
    elif [ "$type" != d ]; then
      printf '\037%s\0' "$path" >>"$work/explain"
    fi
  done <"$work/lines"

  # Every mismatch pacman -Qkk reports for those packages, by path, as
  # "KIND REASON;" entries: KIND is file or backup (a configuration file
  # pacman keeps on upgrade), REASON is "content" for a checksum or size
  # mismatch, else pacman's own words. A bare modification-time mismatch is
  # common and harmless, so it is not kept. pacman prints a total line for
  # each package it finishes; one missing means it stopped part way.
  declare -A bad_of=() no_mtree=()
  if [ "${#need[@]}" -gt 0 ]; then
    # Standard output and error go to files of their own: pacman buffers the
    # first and not the second, so in one file their lines can interleave.
    LC_ALL=C pacman -Qkk "${!need[@]}" >"$work/qkk.out" 2>"$work/qkk.err"
    [ "$(cat "$work/qkk.out" "$work/qkk.err" |
      grep -cE '^[^ :]+: ([0-9]+ total files|no mtree file$)')" -eq "${#need[@]}" ] ||
      cannot_grade "pacman -Qkk did not finish checking the packages" "pacman -Qkk failed"
    while IFS= read -r l; do
      # A package without the file list pacman checks against cannot vouch
      # for any of its files.
      case "$l" in *": no mtree file")
        no_mtree[${l%: no mtree file}]=1
        continue
        ;;
      esac
      case "$l" in
        "warning: "*) rest=${l#warning: } kind=file ;;
        "error: "*) rest=${l#error: } kind=file ;;
        "backup file: "*) rest=${l#backup file: } kind=backup ;;
        *) continue ;;
      esac
      rest=${rest#*: }
      reason=${rest##* (}
      reason=${reason%)}
      p=${rest% (*}
      case "$reason" in
        *"checksum mismatch" | "Size mismatch") bad_of[$p]+="${kind} content;" ;;
        "Symlink path mismatch" | "File type mismatch" | "Permissions mismatch" | \
          "UID mismatch" | "GID mismatch" | "failed to "*) bad_of[$p]+="${kind} ${reason};" ;;
      esac
    done < <(cat "$work/qkk.out" "$work/qkk.err")
  fi
  # True when every entry in $1 is a content mismatch of kind $2.
  only_content() {
    local e IFS=';'
    [ -n "$1" ] || return 1
    for e in $1; do [ "$e" = "$2 content" ] || return 1; done
  }
  # True when $1 has a mismatch other than a group or mode one.
  not_group_mode() {
    local e IFS=';'
    for e in $1; do
      case "$e" in *" GID mismatch" | *" Permissions mismatch") ;; *) return 0 ;; esac
    done
    return 1
  }

  # True when every entry in $1 is a mode, owner or group mismatch, of a
  # file or of a configuration file pacman keeps on upgrade.
  only_mode() {
    local e IFS=';'
    [ -n "$1" ] || return 1
    for e in $1; do
      case "$e" in *" Permissions mismatch" | *" UID mismatch" | *" GID mismatch") ;;
        *) return 1 ;;
      esac
    done
  }
  # Package files whose only fault is their content are asked about too:
  # a local hook listed in scan.conf, or the package's own install script,
  # may have written them. So are those whose only fault is their mode or
  # owner, which a file system without Unix modes, such as a FAT /boot,
  # gives every file, or which a service tightened on its own configuration
  # file. security-report also checks the hook-rebuilt caches, such as
  # glibc's gconv-modules.cache, against what their tools build now.
  for p in "${!bad_of[@]}"; do
    [ -n "${owner_of[$p]-}" ] &&
      { only_content "${bad_of[$p]}" file || only_mode "${bad_of[$p]}"; } &&
      printf '%s\037%s\0' "${owner_of[$p]}" "$p" >>"$work/explain"
  done

  # security-report holds these rules, so the scan and the weekly report
  # agree, and reads the paths on standard input: a link made by a package's
  # install script (literal target, or listed in scan.conf's
  # SCRIPTLET_LINKS); a module index depmod rebuilt; a file the package's own
  # install script wrote while pacman installed it; a package file a local
  # hook listed in scan.conf's HOOK_PATCHED patched. scan.conf's lists are
  # not read when the file itself was ignored. Prints "PATH\037REASON\0".
  report_bin="$(dirname -- "$(readlink -f -- "$0")")/security-report"
  declare -A explained=()
  if [ -s "$work/explain" ] && [ -f "$report_bin" ]; then
    conf_arg=$SCAN_CONF
    [ -n "$conf_error" ] && conf_arg=""
    py "$report_bin" --explain-changes "$conf_arg" /var/log/pacman.log \
      <"$work/explain" >"$work/explained" 2>"$work/explain.err"
    rc=$?
    if [ "$rc" -ne 0 ]; then
      log "!! security-report --explain-changes failed (exit ${rc}); the changes it would have explained are graded without it"
      log_tool <"$work/explain.err"
    fi
    # Each record is PATH, GRADE (PKG or AMBER) and REASON.
    while IFS=$'\037' read -r -d '' p g r; do
      case "$g" in PKG | AMBER) explained[$p]="$g"$'\037'"$r" ;; esac
    done <"$work/explained"
  fi

  # Files a package's own install script hands to a group of its own with
  # the setgid bit (1password's browser helper, its op CLI). pacman's file
  # list keeps the packaged group and mode, so pacman reports a GID and
  # permissions mismatch on every update. security-report does the whole
  # check, so the scan and the report agree. Prints the package.
  scriptlet_setgid() {
    [ -f "$report_bin" ] || return 1
    py "$report_bin" --scriptlet-setgid "$1" 2>/dev/null
  }

  # Package files that a local pacman hook deliberately rewrites. A browser's
  # policies.json gets telemetry and studies switched off after every browser
  # update, so it always fails pacman's checksum. It is explained only while
  # the hook is installed, pacman finds nothing wrong with the file but its
  # content, and the file holds nothing but the browser's own policies and
  # those two switches; any other policy (an extension, a proxy, a
  # certificate) leaves it red. security-report holds the same check, for
  # RED lines logged before this one existed; change both together.
  hook_rewrote() {
    case "$1" in
      /opt/zen-browser-bin/distribution/policies.json)
        [ -x /usr/local/lib/zen-privacy-policy ] &&
          [ -f /etc/pacman.d/hooks/zen-privacy-policy.hook ] &&
          py -c '
import json, sys
p = json.load(open(sys.argv[1])).get("policies")
allowed = {"DisableAppUpdate", "DefaultSerialGuardSetting", "DisableTelemetry", "DisableFirefoxStudies"}
ok = (isinstance(p, dict) and set(p) <= allowed
      and p.get("DisableTelemetry") is True and p.get("DisableFirefoxStudies") is True)
sys.exit(0 if ok else 1)' "$1" 2>/dev/null && echo zen-privacy-policy ;;
    esac
  }

  # limine-snapper-sync rewrites limine.conf, its .old copy and its own
  # snapshots.json whenever snapper creates or removes a snapshot, which
  # happens on timers and around pacman runs that change no package. Such a
  # change is explained only when that program logged writing the file since
  # the last check and the file differs from the trusted copy of limine.conf
  # only inside the Snapshots sub-menu, with nothing there the trusted copy
  # does not already boot. A kernel command line, kernel or initramfs path or
  # any other entry that differs stays red, and so does everything while
  # there is no trusted copy yet. The check lives in security-report, which
  # holds the one implementation; the report cannot repeat it for older RED
  # lines, because /boot and the trusted copy are readable by root only.
  limine_snapshot_change() {
    [ -s "$limine_ref" ] && [ -f "$report_bin" ] || return 1
    py "$report_bin" --limine-snapshot-change "$1" "$limine_ref" "$last_run" \
      >/dev/null 2>&1
  }

  # The modules of a kernel that is no longer installed. kernel-modules-hook
  # keeps the running kernel's modules through an upgrade and deletes them
  # after the next boot, outside any pacman run, which used to list thousands
  # of "unpackaged file removed" lines. security-report decides, once per
  # kernel version; the files are then logged as one line that counts them.
  declare -A kernel_gone=() gone_count=()
  old_kernel() {
    if [ -z "${kernel_gone[$1]-}" ]; then
      kernel_gone[$1]=no
      [ -f "$report_bin" ] &&
        py "$report_bin" --old-kernel-modules "$1" >/dev/null 2>&1 &&
        kernel_gone[$1]=yes
    fi
    [ "${kernel_gone[$1]}" = yes ]
  }

  red=$bad_names amber=0 pkg=0 boot_red=0
  while IFS=$'\t' read -r type what path; do
    # A folder that appears is reported through what is in it. A folder that
    # changed had its mode, owner, ACL or type changed, which is graded like
    # a file's.
    [ "$type" = d ] && [ "$what" = added ] && continue

    # No package owns files in the home folder, so its paths skip pacman and
    # the link checks, which would show them in the process list, and get
    # the verdict those give an unpackaged file.
    owner="" home=0
    if in_home "$path"; then
      home=1
    else
      owner=${owner_of[$path]-}
    fi
    bad=${bad_of[$path]-}
    [ -n "$owner" ] && [ -n "${no_mtree[$owner]-}" ] && bad="file no mtree file;"
    # A path the package lists as a folder must still be one, and the
    # reverse; a folder swapped for a symlink to elsewhere is the case that
    # matters.
    if [ -n "$owner" ] && [ "$what" != removed ]; then
      is_dir=no listed_dir=no
      [ "$type" = d ] && is_dir=yes
      [ -n "${owner_dir[$path]-}" ] && listed_dir=yes
      [ "$is_dir" = "$listed_dir" ] || bad+="file File type mismatch;"
    fi
    explanation=${explained[$path]-}
    ex_grade=${explanation%%$'\037'*}
    ex_reason=${explanation#*$'\037'}
    verdict=""
    if [ -n "$owner" ] && [ "$what" != removed ]; then
      if [ -z "$bad" ]; then
        verdict="PKG ${what} ${path} (${owner}, verified by pacman)"
      elif only_content "$bad" backup; then
        verdict="AMBER ${what} ${path} (config file of ${owner}, edited locally)"
      elif only_content "$bad" file && hook=$(hook_rewrote "$path") && [ -n "$hook" ]; then
        verdict="PKG ${what} ${path} (${owner}, privacy switches added by the ${hook} hook)"
      elif [ -n "$explanation" ]; then
        verdict="${ex_grade} ${what} ${path} (${ex_reason})"
      elif ! not_group_mode "$bad" && sg=$(scriptlet_setgid "$path") && [ -n "$sg" ]; then
        verdict="PKG ${what} ${path} (${owner}, group and setgid bit set by its install script)"
      elif not_group_mode "$bad"; then
        verdict="RED ${what} ${path} (owned by ${owner} but fails pacman's checksum)"
      else
        verdict="RED ${what} ${path} (owned by ${owner} but fails pacman's ownership or permission check)"
      fi
    elif [ -n "$owner" ]; then
      # Removed, yet pacman still lists the file for an installed package,
      # so no package change took it away.
      verdict="AMBER ${what} ${path} (owned by ${owner} but missing, confirm it was you)"
    elif [ "$what" = removed ]; then
      version=""
      if [ "$home" -eq 0 ]; then
        case "$path" in
          /usr/lib/modules/?*)
            version=${path#/usr/lib/modules/}
            version=${version%%/*}
            ;;
        esac
      fi
      was=""
      [ "$home" -eq 0 ] && was=${was_owner_of[$path]-}
      if [ -n "$version" ] && old_kernel "$version"; then
        gone_count[$version]=$((${gone_count[$version]:-0} + 1))
        continue
      elif [ -n "$was" ] && [ -n "${pkg_changed[$was]-}" ]; then
        verdict="PKG ${what} ${path} (${was}'s at the last check, removed when pacman changed ${was})"
      else
        verdict="AMBER ${what} ${path} (unpackaged file removed)"
      fi
    elif [ "$home" -eq 0 ] && [ -n "$explanation" ]; then
      verdict="${ex_grade} ${what} ${path} (${ex_reason})"
    else
      case "$path" in
        /boot/*)
          if [ "${pacman_since:-0}" -gt 0 ]; then
            verdict="PKG ${what} ${path} (boot image rebuilt after a package update)"
          elif limine_snapshot_change "$path"; then
            verdict="PKG ${what} ${path} (snapshot menu rewritten by limine-snapper-sync, the rest matches the trusted copy)"
          else
            verdict="RED ${what} ${path} (boot file changed with no package update)"
            boot_red=1
          fi
          ;;
        /usr/local/* | /opt/* | /etc/* | /root/* | /home/*)
          verdict="AMBER ${what} ${path} (not from a package, confirm it was you)"
          ;;
        *)
          # The desktop user's home folder is amber wherever it is.
          if [ "$home" -eq 1 ]; then
            verdict="AMBER ${what} ${path} (not from a package, confirm it was you)"
          else
            # One written while pacman ran is amber through $explanation
            # above (security-report's written_in_pacman_run()).
            verdict="RED ${what} ${path} (unpackaged file in a system code path)"
          fi
          ;;
      esac
    fi

    case "$verdict" in
      RED*) red=$((red + 1)) ;;
      AMBER*) amber=$((amber + 1)) ;;
      PKG*) pkg=$((pkg + 1)) ;;
    esac
    log "$verdict"
  done <"$work/lines"
  for version in "${!gone_count[@]}"; do
    n=${gone_count[$version]}
    pkg=$((pkg + n))
    log "PKG removed /usr/lib/modules/${version} (${n} entries, the modules of kernel ${version}, which is no longer installed)"
  done

  # A package update that started while the changes were being graded may
  # have changed what pacman said about them part way through.
  pacman_ran && set_aside "pacman installed or removed packages while this check ran" \
    "package update during the check"

  # Keep the copy taken before the check as the trusted limine.conf only when
  # nothing under /boot is red and the file is still what was copied. A run
  # with a red keeps the old copy; like the AIDE baseline, the copy moves on
  # at the next run that finds nothing red, so a red is reported once.
  if [ -n "$limine_new" ]; then
    if [ "$boot_red" -eq 0 ] && cmp -s "$limine_new" /boot/limine.conf; then
      mv -f "$limine_new" "$limine_ref"
    else
      rm -f "$limine_new"
    fi
  fi

  if [ -s /var/lib/aide/aide.db.new.gz ]; then
    cp -f "$db" /var/lib/aide/aide.db.prev.gz
    mv -f /var/lib/aide/aide.db.new.gz "$db"
    # The package file lists that go with the new baseline.
    install -d -m 0700 /var/lib/security-scan
    install -m 0600 "$work/owners.gz" "$owners_ref"
  fi
  rm -rf "$work"

  log ""
  log "summary: ${red} unexplained, ${amber} to confirm, ${pkg} from package updates"

  if [ "$red" -gt 0 ]; then
    notify critical "File integrity: ${red} unexplained change(s)" \
      "System files changed outside any package update. See ${LOG}"
  fi
  ;;

rkhunter)
  # rkhunter's own greps trip GNU grep's obsolescence warnings; drop those.
  out=$(rkhunter --check --sk --nocolors --rwo 2>&1 | grep -v -E '^(e?grep|fgrep): warning')
  printf '%s\n' "$out" | log_tool

  # rkhunter has no pacman support, so after an upgrade it reports every new
  # binary as "file properties changed". Accept those only when pacman
  # verifies the file byte-for-byte, then re-record the properties.
  accepted=0 open=0
  changed=$(printf '%s\n' "$out" | awk '/file properties have changed/{f=1; next} /^Warning:/{f=0} f && /File: /{print $2}')
  unverified=""
  # pacman -Qkk once per package: an upgrade can change many binaries of one
  # package. A file swapped for a symlink shows only as a file type mismatch.
  declare -A rk_bad=()
  for f in $changed; do
    # A home folder file, if rkhunter is set to watch one, has no package to
    # verify it and must not reach a command line; it stays unverified.
    owner=""
    in_home "$f" || owner=$(LC_ALL=C pacman -Qqo "$f" 2>/dev/null | head -1)
    bad=""
    if [ -n "$owner" ]; then
      [ -n "${rk_bad[$owner]+x}" ] || rk_bad[$owner]=$(LC_ALL=C pacman -Qkk "$owner" 2>&1 |
        grep -E 'checksum mismatch|Size mismatch|Symlink path mismatch|Permissions mismatch|UID mismatch|GID mismatch|File type mismatch|failed to calculate|no mtree file')
      bad=${rk_bad[$owner]}
    fi
    if [ -n "$owner" ] && ! grep -qF " ${f} " <<<"$bad" && [[ "$bad" != *"no mtree file"* ]]; then
      accepted=$((accepted + 1))
    elif [ -n "$owner" ] && py "$(dirname -- "$(readlink -f -- "$0")")/security-report" \
      --scriptlet-setgid "$f" >/dev/null 2>&1; then
      # Its install script set the group and setgid bit, see scriptlet_setgid.
      accepted=$((accepted + 1))
    else
      unverified="${unverified}${f} "
    fi
  done

  warnings=$(printf '%s\n' "$out" | grep -c '^Warning:' || true)
  props=$(printf '%s\n' "$out" | grep -c 'file properties have changed' || true)
  # One "properties changed" warning covers every changed file in it.
  if [ -n "$changed" ] && [ -z "$unverified" ]; then
    open=$((warnings - props))
    rkhunter --propupd --nocolors >/dev/null 2>&1
  else
    open=$warnings
  fi

  log ""
  for f in $unverified; do log "UNVERIFIED $(clean "$f")"; done
  log "summary: ${open} warning(s), ${accepted} changed file(s) verified by pacman"

  if [ "$open" -gt 0 ]; then
    notify critical "Rootkit check: ${open} warning(s)" "See ${LOG}"
  fi
  ;;

models)
  # safetensors and GGUF are data only. Pickle-based formats (.ckpt .pt .pth
  # .bin .pkl) can run code when loaded, which is what picklescan looks for.
  dangerous=0 suspicious=0 scanned=0 pickles=0 failed=0
  SKIP_DIRS='(\.venv|venv|site-packages|node_modules|\.git)$'
  for root in $MODEL_ROOTS; do
    [ -d "$root" ] || continue
    # Python environments hold library test fixtures, not models, and flood
    # the scan with parse warnings. Supply-chain risk in pip packages is a
    # different problem this scan does not claim to cover.
    # Scan from inside the folder, so its path stays out of the command line,
    # which any local user can read in the process list for the whole scan.
    # picklescan still prints full paths, which go only to the log.
    out=$(cd -- "$root" 2>/dev/null || { echo "cannot enter the folder"; exit 2; }
      picklescan -p . --exclude-dir "$SKIP_DIRS" 2>&1)
    log "--- $(clean "$root") ---"
    printf '%s\n' "$out" | log_tool
    # The counts come only from picklescan's own summary, the block after
    # the last "SCAN SUMMARY" line, which it prints after every file it
    # names. An import name in a crafted file can hold new lines and
    # imitate those lines, but only earlier in the output. A count that is
    # not a plain number, or a crash mid-scan that prints a traceback and no
    # summary, is a failed scan, not a clean one.
    block=$(printf '%s\n' "$out" |
      awk '/^-+ SCAN SUMMARY -+$/ { b = ""; f = 1; next } f { b = b $0 "\n" } END { printf "%s", b }')
    count() { printf '%s\n' "$block" | sed -n "s/^$1: \([0-9]\{1,9\}\)\$/\1/p" | tail -1; }
    s_scanned=$(count "Scanned files")
    s_dangerous=$(count "Dangerous globals")
    s_suspicious=$(count "Suspicious globals")
    if [ -z "$s_scanned" ] || [ -z "$s_dangerous" ] || [ -z "$s_suspicious" ]; then
      log "!! picklescan did not finish on $(clean "$root")"
      failed=$((failed + 1))
      continue
    fi
    scanned=$((scanned + 10#$s_scanned))
    dangerous=$((dangerous + 10#$s_dangerous))
    suspicious=$((suspicious + 10#$s_suspicious))
    # Counted from inside the folder too, for the same reason.
    n=$(cd -- "$root" 2>/dev/null && find -L . -type d -regextype posix-extended -regex ".*/${SKIP_DIRS}" -prune -o \
      -type f \( -iname '*.ckpt' -o -iname '*.pt' -o -iname '*.pth' -o -iname '*.bin' -o -iname '*.pkl' -o -iname '*.pickle' \) -print 2>/dev/null | wc -l)
    pickles=$((pickles + ${n:-0}))
  done

  log ""
  if [ "$failed" -gt 0 ]; then
    log "summary: error, ${failed} folder(s) not scanned"
    notify critical "Model scan failed" "picklescan did not finish. See ${LOG}"
  else
    log "summary: ${dangerous} dangerous, ${suspicious} suspicious, ${scanned} file(s) scanned, ${pickles} pickle-format file(s)"
  fi

  if [ "$dangerous" -gt 0 ]; then
    notify critical "Malicious model file found" \
      "${dangerous} dangerous import(s). Do not load it. See ${LOG}"
  elif [ "$suspicious" -gt 0 ]; then
    notify normal "Model scan: ${suspicious} suspicious import(s)" "See ${LOG}"
  fi
  ;;

esac

prune
log "=== done at $(date -Is) ==="
exit 0
