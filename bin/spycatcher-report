#!/usr/bin/env python3
"""Spycatcher report: grades the spycatcher-scan logs red, amber, green.

    spycatcher-report               colour report in the terminal
    spycatcher-report --plain       same, without colour
    spycatcher-report --all         also list the green items
    spycatcher-report --html FILE   self-contained HTML page
    spycatcher-report --days N      look back N days instead of 7
    spycatcher-report --json        machine-readable, for the bar widget
    spycatcher-report --status      the overall rating and summary line only

Reads /var/log/spycatcher (written by `spycatcher-scan`) and the risk
register at /etc/spycatcher/risk-register.toml, which records what each
known finding means here and what is being done about it. A finding with no
register entry is reported as unassessed rather than silently passed.

The Privacy section reads one file written by Black Ops,
~/.local/state/black-ops/summary.json, which holds counts only. It never
reads any other Black Ops file and never runs Black Ops.
"""

import argparse
import contextlib
import functools
import datetime as dt
import grp
import gzip
import hashlib
import html
import json
import os
import pwd
import re
import shlex
import shutil
import stat
import subprocess
import sys
import tempfile
import tomllib
from pathlib import Path

LOG_DIR = Path(os.environ.get("LOG_DIR", "/var/log/spycatcher"))
REGISTER = Path(os.environ.get("RISK_REGISTER", "/etc/spycatcher/risk-register.toml"))
SCAN_CONF = Path(os.environ.get("SCAN_CONF", "/etc/spycatcher/scan.conf"))
PACMAN_LOG = Path(os.environ.get("PACMAN_LOG", "/var/log/pacman.log"))
ACKS = Path(os.environ.get("SPYCATCHER_ACKS", "/etc/spycatcher/acknowledged.json"))

GREEN, AMBER, RED = "green", "amber", "red"
# Grey is neutral: off, not installed, or not applicable. It never makes a
# section or the overall rating worse, so it ranks below green.
GREY = "grey"
ORDER = {GREY: -1, GREEN: 0, AMBER: 1, RED: 2}

# How long each scan may go quiet before the silence is itself a finding.
# Amber at the first number of days, red at the second.
SCANS = {
    "arch-audit": ("Daily", 2, 7),
    "aide": ("Daily", 2, 7),
    "models": ("Daily", 2, 7),
    "gitleaks": ("Weekly", 9, 21),
    "rkhunter": ("Weekly", 9, 21),
    "lynis": ("Monthly", 35, 62),
}


def worst(*ratings):
    return max(ratings, key=lambda r: ORDER[r]) if ratings else GREEN


def overall_of(sections):
    # A grey section has nothing to grade, so it does not count. If every
    # section were grey there would be nothing wrong to report.
    rated = [s.rating for s in sections if s.rating != GREY]
    return worst(*rated) if rated else GREEN


# Control characters, and the Unicode marks that reorder text on screen.
# Finding text comes from scanned files, file names, repository names and
# package output, so it may hold a terminal escape sequence that rewrites what
# the terminal shows, or a bidirectional override that makes a name read as
# something else. Each one is shown as "?" instead.
_UNSAFE_CHARS = re.compile("[\x00-\x08\x0a-\x1f\x7f-\x9f\u061c\u200b-\u200f\u2028-\u202e"
                           "\u2066-\u2069\ufeff]")


def plain(text):
    """`text` as a string safe to print: control characters, new lines
    among them, and invisible or reordering marks replaced with "?", so a
    finding is one line that reads as it is. A tab is kept. Markup is left
    as it is: the HTML report escapes it, and the bar panel shows every
    string as plain text."""
    return _UNSAFE_CHARS.sub("?", str(text))


class Section:
    def __init__(self, title, rating, headline):
        self.title = title
        self.rating = rating
        self.headline = headline
        self.items = []  # (rating, what, detail, action)

    def add(self, rating, what, detail="", action=""):
        self.items.append((rating, plain(what), plain(detail), plain(action)))
        self.rating = worst(self.rating, rating)


# --- log reading -------------------------------------------------------------

def logs(mode, since):
    out = []
    for p in LOG_DIR.glob(f"{mode}-*.log"):
        m = re.match(rf"{re.escape(mode)}-(\d{{8}}-\d{{6}})\.log$", p.name)
        if not m:
            continue
        when = dt.datetime.strptime(m.group(1), "%Y%m%d-%H%M%S")
        # A run that skipped itself (arch-audit offline) is not a result.
        # Counting it would hide the last real findings behind an empty log.
        if (summary(read(p)) or "").startswith("skipped"):
            continue
        out.append((when, p))
    out.sort()
    recent = [(w, p) for w, p in out if w >= since]
    latest = out[-1] if out else None
    # A window shorter than a scan's cadence (one day against a weekly
    # rkhunter) would otherwise read as "no result". The latest run always
    # counts; whether it is overdue is the scan health section's call.
    if not recent and latest:
        recent = [latest]
    return recent, latest


# Logs read during one run of the report, by path, size and modification
# time: several sections read the same logs, and an AIDE log after a large
# update runs to tens of megabytes.
_READ_CACHE = {}


def read(p):
    try:
        st = os.stat(p)
        key = (str(p), st.st_size, st.st_mtime_ns)
        if key not in _READ_CACHE:
            if len(_READ_CACHE) > 64:
                _READ_CACHE.clear()
            _READ_CACHE[key] = Path(p).read_text(errors="replace")
        return _READ_CACHE[key]
    except OSError:
        return ""


def summary(text):
    """The last line the scan wrote that starts "summary: ", without that
    prefix, or None. Searched from the end, since logs can be large."""
    end = len(text)
    while True:
        i = text.rfind("summary: ", 0, end)
        if i < 0:
            return None
        if i == 0 or text[i - 1] == "\n":
            j = text.find("\n", i)
            return text[i + 9:j if j >= 0 else len(text)]
        end = i


def ago(when, now):
    d = now - when
    if d.days >= 1:
        return f"{d.days} day{'s' if d.days != 1 else ''} ago"
    h = d.seconds // 3600
    return f"{h} hour{'s' if h != 1 else ''} ago" if h else "within the hour"


# --- sections ----------------------------------------------------------------

# A log with no summary line is a run that is still going or one that was
# stopped. A run started by hand has no unit to ask, so a log written to in
# the last few minutes also counts as still going.
QUIET_MINUTES = 10
# TimeoutStartSec of spycatcher@.service.
TIME_LIMIT_MINUTES = 45
# An AIDE check set aside because pacman was running ("summary: skipped") is
# not a result. One is normal; checks set aside for this long are a finding.
SKIPPED_AMBER_DAYS, SKIPPED_RED_DAYS = 1, 3


def _unit(mode, prop):
    """A property of the scan's systemd unit, or "" when it cannot be read."""
    return run(["systemctl", "show", "--value", "-p", prop,
                f"spycatcher@{mode}.service"]).strip()


def _still_running(mode, p, now):
    if _unit(mode, "ActiveState") in ("active", "activating", "reloading"):
        return True
    try:
        written = dt.datetime.fromtimestamp(Path(p).stat().st_mtime)
    except OSError:
        return False
    return now - written < dt.timedelta(minutes=QUIET_MINUTES)


def skipped_aide(s, now):
    """Adds a finding when the AIDE checks since the last graded one were all
    set aside, the first of them a day ago or more."""
    runs = []
    for p in LOG_DIR.glob("aide-*.log"):
        m = re.match(r"aide-(\d{8}-\d{6})\.log$", p.name)
        if m:
            runs.append((dt.datetime.strptime(m.group(1), "%Y%m%d-%H%M%S"), p))
    runs.sort()
    skipped = []
    for when, p in reversed(runs):
        text = read(p)
        if not (summary(text) or "").startswith("skipped"):
            break
        skipped.insert(0, (when, text))
    if not skipped:
        return
    first = skipped[0][0]
    days = (now - first).days
    if days < SKIPPED_AMBER_DAYS:
        return
    why = re.findall(r"^(.*), so this check was set aside", skipped[-1][1], re.M)
    s.add(RED if days >= SKIPPED_RED_DAYS else AMBER,
          f"aide: {len(skipped)} check(s) since {first:%a %d %b} were set aside",
          (why[-1] + ".") if why else "",
          "AIDE grades nothing while pacman is running. If no package manager is open, "
          "check for a stuck pacman, or remove a lock file nothing holds: "
          "sudo rm /var/lib/pacman/db.lck")


def scan_health(now, since):
    s = Section("Scans ran on schedule", GREEN, "")
    late = 0
    for mode, (cadence, amber_days, red_days) in SCANS.items():
        runs, _ = logs(mode, dt.datetime.min)
        if not runs:
            s.add(RED, f"{mode} has never run", "", f"Check: systemctl status spycatcher-scan-{mode}.timer")
            late += 1
            continue
        when, p = runs[-1]
        text = read(p)
        if summary(text) is None and _still_running(mode, p, now):
            # Grade the run before this one; this one has no result yet.
            if len(runs) == 1:
                s.add(GREEN, f"{mode}: first run in progress, started {ago(when, now)}")
                continue
            runs = runs[:-1]
            when, p = runs[-1]
            text = read(p)
        age = (now - when).days
        failed = ((summary(text) or "").startswith("error")
                  or re.search(r"^!! ", text, re.M) is not None)
        if summary(text) is None:
            # Stopped before it wrote a result: nothing it found was graded,
            # and for AIDE the baseline did not move, so the next run meets
            # the same changes. Once may be a shutdown; a time-out, or twice
            # in a row, will not clear up on its own.
            before = runs[-2][1] if len(runs) > 1 else None
            again = before is not None and summary(read(before)) is None
            # The unit's result describes its latest start, which a new run
            # resets, so a log that kept being written to for the whole
            # time limit counts as timed out as well.
            try:
                lasted = dt.datetime.fromtimestamp(Path(p).stat().st_mtime) - when
            except (OSError, TypeError):
                lasted = dt.timedelta(0)
            timed_out = (_unit(mode, "Result") == "timeout"
                         or lasted >= dt.timedelta(minutes=TIME_LIMIT_MINUTES - 1))
            what = ("ran past its time limit" if timed_out
                    else "stopped before it wrote a result")
            journal = f"journalctl -u spycatcher@{mode}.service"
            action = (f"Check: {journal}. The next run meets the same work, so it needs a "
                      "fix, not a wait." if timed_out or again else
                      "Usually the machine shut down mid-run, and the next run catches up. "
                      f"If it repeats, check: {journal}")
            s.add(RED if timed_out or again else AMBER,
                  f"{mode}: last run did not finish ({ago(when, now)})",
                  f"The run {what}, so nothing it found was graded. {p}", action)
        elif failed:
            s.add(RED, f"{mode}: last run failed ({ago(when, now)})", str(p),
                  "Read the log; the scan is not protecting anything until this is fixed.")
        elif age >= red_days:
            s.add(RED, f"{mode}: {cadence.lower()} scan last ran {ago(when, now)}", "",
                  f"Check: systemctl status spycatcher-scan-{mode}.timer")
            late += 1
        elif age >= amber_days:
            s.add(AMBER, f"{mode}: {cadence.lower()} scan last ran {ago(when, now)}", "",
                  "Usually the laptop was off or offline; it catches up on its own.")
            late += 1
        else:
            s.add(GREEN, f"{mode}: {cadence.lower()}, last ran {ago(when, now)}")
    skipped_aide(s, now)
    bad = sum(1 for r, *_ in s.items if r != GREEN)
    s.headline = "All six scans are running on time." if not bad else f"{bad} of 6 scans need attention."
    return s


def packages(now, since, reg, installed):
    s = Section("Known vulnerabilities in installed packages", GREEN, "")
    _, latest = logs("arch-audit", since)
    if not latest:
        s.rating, s.headline = AMBER, "No arch-audit result yet."
        return s
    text = read(latest[1])
    # Tool output is logged with "| " in front since 0.2.12.
    affected = re.findall(r"^(?:\| )?(\S+) is affected by (.*?)\. (High|Medium|Low|Critical) risk!",
                          text, re.M)
    fixable = re.search(r"(\d+) fixable by upgrade", summary(text) or "")
    fixable = int(fixable.group(1)) if fixable else 0

    if fixable:
        s.add(RED, f"{fixable} package(s) have a fix waiting", "",
              "Run: sudo pacman -Syu")

    cves = reg.get("cve", {})
    counts = {GREEN: 0, AMBER: 0, RED: 0}
    for name, what, severity in affected:
        e = cves.get(name)
        if not e:
            r = RED if severity in ("High", "Critical") else AMBER
            s.add(r, f"{name}: {what} ({severity.lower()} risk)",
                  "New since the last assessment.",
                  "Not yet assessed. Ask Claude to assess it and add it to the risk register.")
            counts[r] += 1
            continue
        r = e.get("rating", AMBER)
        ver = installed.get(name)
        if ver and e.get("assessed_version") and vercmp(ver, e["assessed_version"]) < 0:
            r = worst(r, AMBER)
            s.add(r, f"{name}: installed {ver} is older than the assessed {e['assessed_version']}",
                  e.get("finding", ""), "Re-assess this entry.")
        else:
            label = {"stale": "tracker out of date, already fixed", "open": "no fix yet, managed",
                     "accepted": "accepted"}.get(e.get("status"), e.get("status", ""))
            s.add(r, f"{name}: {e.get('risk', what)}", f"{label.capitalize()}. {e.get('finding', '')}",
                  e.get("action", ""))
        counts[r] += 1

    total = len(affected)
    stale = sum(1 for n, *_ in affected if cves.get(n, {}).get("status") == "stale")
    if not total:
        s.headline = "No installed package has a known vulnerability."
    else:
        parts = [f"The Arch tracker lists {total} package(s)."]
        if stale:
            parts.append(f"{stale} are already fixed in the installed version; the tracker has not caught up.")
        live = total - stale
        if live:
            parts.append(f"{live} are genuinely unfixed and managed as described.")
        if fixable:
            parts.insert(0, f"{fixable} update(s) are waiting to be installed.")
        s.headline = " ".join(parts)
    return s


# Package files that a local pacman hook deliberately rewrites, so they always
# fail pacman's checksum. Kept in step with hook_rewrote() in spycatcher-scan,
# which classifies them at scan time; this copy re-checks a RED line logged
# before the scanner knew about the hook, against the file as it is now. The
# log is left as written. Each entry: the hook's files, which must still be
# installed, and a check of the file's content.
def _zen_policies_ok(path):
    try:
        p = json.loads(Path(path).read_text()).get("policies")
    except (OSError, ValueError, AttributeError):
        return False
    allowed = {"DisableAppUpdate", "DefaultSerialGuardSetting", "DisableTelemetry", "DisableFirefoxStudies"}
    return (isinstance(p, dict) and set(p) <= allowed
            and p.get("DisableTelemetry") is True and p.get("DisableFirefoxStudies") is True)


HOOK_REWRITTEN = {
    "/opt/zen-browser-bin/distribution/policies.json": (
        ("/usr/local/lib/zen-privacy-policy", "/etc/pacman.d/hooks/zen-privacy-policy.hook"),
        _zen_policies_ok,
    ),
}


def hook_explains(line):
    """True when a RED checksum line is a file a local hook rewrites, the hook
    is still installed, and the file still passes its content check."""
    m = re.match(r"changed (.+) \(owned by \S+ but fails pacman's checksum\)$", line)
    if not m or m.group(1) not in HOOK_REWRITTEN:
        return False
    files, ok = HOOK_REWRITTEN[m.group(1)]
    return all(os.path.exists(f) for f in files) and ok(m.group(1))


# pacman's messages are matched as English text, so it always runs in the C
# locale.
# Every program the report starts is named by its full path and runs with
# this environment alone, so nothing in the desktop session, such as a
# folder early in PATH, GCONV_PATH, GTK_PATH or GIO_EXTRA_MODULES, can steer
# what it runs or what a rebuilt cache holds. pacman's messages are matched
# as English text, so everything runs in the C locale.
TOOLS = "/usr/bin"
SAFE_ENV = {"PATH": "/usr/bin:/usr/sbin:/bin:/sbin", "LC_ALL": "C"}
_C_LOCALE = SAFE_ENV


def _tool(name):
    return os.path.join(TOOLS, name)


def _pacman(*args):
    """pacman's output for `args`, or None if it fails. A path asked about
    with -Qqo is passed on standard input, which pacman reads for the target
    "-", rather than as an argument: a command line can be read by any local
    user in the process list, and a link in a system folder may point into a
    home folder or a repository whose name is private."""
    if _PACMAN_CACHE is not None and args in _PACMAN_CACHE:
        return _PACMAN_CACHE[args]
    key, stdin = args, None
    if args[:2] == ("-Qqo", "--") and len(args) == 3:
        if "\n" in args[2]:
            return None
        args, stdin = ("-Qqo", "-"), args[2] + "\n"
    try:
        r = subprocess.run([_tool("pacman"), *args], input=stdin, capture_output=True, text=True,
                           timeout=60, env=_C_LOCALE)
        out = r.stdout if r.returncode == 0 else None
    except (OSError, subprocess.SubprocessError):
        out = None
    if _PACMAN_CACHE is not None:
        _PACMAN_CACHE[key] = out
    return out


def _names_exactly(text, path):
    """True when `path` appears in `text` on its own, not as the start of a
    longer path."""
    return re.search(re.escape(path) + r"(?![A-Za-z0-9_.-])", text) is not None


# Options of ln(1) that take no argument and leave the meaning of
# `ln -s TARGET LINK` unchanged. Anything else, such as -t, makes the command
# too hard to read with certainty.
_LN_SHORT = set("sfnrvLPT")
_LN_LONG = {"--symbolic", "--force", "--no-dereference", "--relative", "--verbose",
            "--logical", "--physical", "--no-target-directory"}
_LN_LEAD = {"then", "do", "else", "{", "!", "command"}


def _shell_commands(line):
    """The simple commands on one line of shell, each as its list of words
    with the command name first, or None when the line cannot be split into
    words."""
    lex = shlex.shlex(line, posix=True, punctuation_chars=True)
    lex.whitespace_split = True
    lex.commenters = "#"
    try:
        tokens = list(lex)
    except ValueError:
        return None
    commands, words = [], []
    skip = False
    for tok in tokens + [";"]:
        if skip:
            skip = False
            continue
        if tok and all(c in "();<>|&" for c in tok):
            if tok[0] in "<>":
                # A redirection: drop its file, and a file descriptor number.
                skip = True
                if words and words[-1].isdigit():
                    words.pop()
                continue
            while words and words[0] in _LN_LEAD:
                words.pop(0)
            if words:
                commands.append(words)
            words = []
        else:
            words.append(tok)
    return commands


def _ln_commands(line):
    """The ln commands on one line of shell, each as its list of arguments,
    or None when the line cannot be split into words."""
    commands = _shell_commands(line)
    if commands is None:
        return None
    return [w[1:] for w in commands if w[0] == "ln" or w[0].endswith("/ln")]


def _ln_operands(args):
    """(symbolic, operands) for the arguments of one ln command, or None when
    it has an option this does not understand."""
    symbolic, operands, opts_done = False, [], False
    for a in args:
        if opts_done or a == "-" or not a.startswith("-"):
            operands.append(a)
        elif a == "--":
            opts_done = True
        elif a.startswith("--"):
            if a not in _LN_LONG:
                return None
            symbolic |= a == "--symbolic"
        elif set(a[1:]) <= _LN_SHORT:
            symbolic |= "s" in a
        else:
            return None
    return symbolic, operands


def scriptlet_link_target(script, link):
    """The file that `script` (a package's install script) makes `link` point
    at, fully resolved, or None when that cannot be told with certainty.

    Every `ln` command whose last argument is exactly `link` must be a plain
    `ln -s TARGET LINK` with a literal TARGET: no variable, command
    substitution or glob. All of them must resolve to the same file. A target
    held in a variable, two different targets, an ln without -s, or an option
    this does not understand all give None, so the link stays red."""
    text = re.sub(r"\\\n", " ", script)
    found = set()
    for line in text.splitlines():
        if not _names_exactly(line, link):
            continue
        commands = _ln_commands(line)
        if commands is None:
            return None
        for args in commands:
            if link not in args:
                continue
            parsed = _ln_operands(args)
            if parsed is None:
                return None
            symbolic, operands = parsed
            if operands[-1] != link:
                continue    # The link is the source here, not the link made.
            if len(operands) != 2 or not symbolic:
                return None
            target = operands[0]
            if not target or any(c in target for c in "$`*?[]{}~\\"):
                return None
            found.add(os.path.realpath(os.path.join(os.path.dirname(link), target)))
    return found.pop() if len(found) == 1 else None


# What pacman -Qkk says of a file whose content, link, type, mode or owner is
# not as packaged. A bare modification-time mismatch is harmless and common.
# A file replaced by a symlink, or a symlink by a file, is reported only as a
# file type mismatch.
_QKK_BAD = re.compile(r"checksum mismatch|Size mismatch|Symlink path mismatch|Permissions mismatch"
                      r"|UID mismatch|GID mismatch|File type mismatch")
# Mismatches that mean only the content changed.
_QKK_CONTENT = re.compile(r"\((?:\S+ )?checksum mismatch\)$|\(Size mismatch\)$"
                          r"|\(Modification time mismatch\)$")

# pacman's answers, kept for one run of the report or of --explain-changes,
# which ask about the same few packages and files many times. The package
# database does not change while one run reads it. None means no caching,
# as when the functions are called one at a time.
_QKK_CACHE = None
_PACMAN_CACHE = None


def _qkk(owner):
    """pacman -Qkk's output for package `owner`, or None when it fails."""
    if _QKK_CACHE is not None and owner in _QKK_CACHE:
        return _QKK_CACHE[owner]
    try:
        checked = subprocess.run([_tool("pacman"), "-Qkk", owner], capture_output=True, text=True,
                                 timeout=300, env=_C_LOCALE)
        out = checked.stdout + checked.stderr
    except (OSError, subprocess.SubprocessError):
        out = None
    if _QKK_CACHE is not None:
        _QKK_CACHE[owner] = out
    return out


def _qkk_said(owner, path):
    """The lines of pacman -Qkk `owner` that are about `path`, or None when
    pacman could not be run."""
    out = _qkk(owner)
    # A package without the file list pacman checks against vouches for
    # nothing.
    if out is None or re.search(rf"^{re.escape(owner)}: no mtree file$", out, re.M):
        return None
    return [l for l in out.splitlines() if f" {path} " in l]


def _pacman_verifies(owner, target):
    """True when pacman -Qkk finds no mismatch for `target` in package
    `owner`."""
    said = _qkk_said(owner, target)
    if said is None:
        return False
    return not any(_QKK_BAD.search(l) or "failed to calculate" in l for l in said)


def _content_only(owner, path):
    """True when everything pacman -Qkk says about `path` in package `owner`
    is a checksum, size or time mismatch: its type, link target, mode and
    owner are as packaged."""
    said = _qkk_said(owner, path)
    return said is not None and all(_QKK_CONTENT.search(l) for l in said)


def scriptlet_link_explains(line):
    """True when a RED unpackaged-file line is a symlink a package's own
    install script makes: it still resolves to a file the package owns, pacman
    finds that file unaltered, and the install script's own `ln -s` command
    for the link's exact path points it at that same file. spycatcher-scan
    calls scriptlet_link_target() through --scriptlet-link-target, so both
    use this one parser."""
    m = re.match(r"(?:added|changed) (.+) \(unpackaged file in a system code path\)$", line)
    return bool(m and scriptlet_link_package(m.group(1)))


def scriptlet_link_package(path):
    """The package whose install script makes the symlink `path`, by the
    rule in scriptlet_link_explains(), or None."""
    if not os.path.islink(path):
        return None
    target = os.path.realpath(path)
    if not os.path.isfile(target):
        return None
    owner = (_pacman("-Qqo", "--", target) or "").split("\n")[0].strip()
    version = (_pacman("-Q", "--", owner) or "").split() if owner else []
    if len(version) != 2:
        return None
    if not _pacman_verifies(owner, target):
        return None
    try:
        script = Path(f"/var/lib/pacman/local/{owner}-{version[1]}/install").read_text()
    except OSError:
        return None
    want = scriptlet_link_target(script, path)
    return owner if want is not None and want == target else None


_ASSIGN = re.compile(r"([A-Za-z_][A-Za-z0-9_]*)=(.*)$", re.S)
_VAR_REF = re.compile(r"\$(?:([A-Za-z_][A-Za-z0-9_]*)|\{([A-Za-z_][A-Za-z0-9_]*)\})$")


_FUNC_DEF = re.compile(r"([A-Za-z_][A-Za-z0-9_]*)\s*\(\)\s*\{?\s*$")
_OPEN_BLOCK = {"if", "while", "until", "for", "case", "select"}
_CLOSE_BLOCK = {"fi", "done", "esac"}
_UNSAFE = "$`*?[]{}~\\"


def _sure_commands(script):
    """The commands of an install script that certainly run when pacman calls
    post_install or post_upgrade, as lists of words, and every command, or
    None when the script is not plain enough to tell.

    A command certainly runs when it sits at the top level of the script or
    of a function reached from those two by plain calls, outside any if, case
    or loop, and not after && or ||. Functions must be written
    `name() {` on a line of their own at the start of the line and close with
    `}` at the start of a line. A heredoc gives None, since its body is text
    that looks like commands."""
    if "<<" in script:
        return None
    text = re.sub(r"\\\n", " ", script)
    functions, top, current = {}, [], None
    for line in text.splitlines():
        m = _FUNC_DEF.match(line)
        if m:
            if current is not None:
                return None
            current = functions.setdefault(m.group(1), [])
            if not line.rstrip().endswith("{"):
                return None
            continue
        if re.match(r"\s*(?:function\s|[A-Za-z_][A-Za-z0-9_]*\s*\(\))", line):
            return None    # A function written some other way.
        if line.startswith("}"):
            if current is None or line.strip() != "}":
                return None
            current = None
            continue
        commands = _shell_commands(line)
        if commands is None:
            return None
        guarded = "&&" in line or "||" in line
        (top if current is None else current).append((commands, guarded))
    if current is not None:
        return None

    def walk(body):
        """(words, sure) for each command in a body, tracking block depth."""
        depth = 0
        for commands, guarded in body:
            for words in commands:
                if words[0] in _CLOSE_BLOCK:
                    depth -= 1
                yield words, depth == 0 and not guarded
                if words[0] in _OPEN_BLOCK:
                    depth += 1

    reached, todo = set(), [f for f in ("post_install", "post_upgrade") if f in functions]
    bodies = [top]
    while todo:
        name = todo.pop()
        if name in reached:
            continue
        reached.add(name)
        bodies.append(functions[name])
        for words, sure in walk(functions[name]):
            if sure and words[0] in functions:
                todo.append(words[0])
    sure_cmds = [w for body in bodies for w, sure in walk(body) if sure]
    every = [w for body in [top, *functions.values()] for w, _ in walk(body)]
    return sure_cmds, every


def scriptlet_setgid_group(script, path):
    """The group that `script` (a package's install script) gives `path`
    together with the setgid bit, or None when that cannot be told with
    certainty.

    Some packages hand a binary to a group of its own after installing it, so
    only that group's members can talk to it: 1password runs
    `chgrp onepassword` and `chmod g+s` on its browser helper. pacman's file
    list still holds the packaged group and mode, so pacman -Qkk reports a GID
    and permissions mismatch for a file whose content is untouched.

    Every chgrp, chmod and chown command must be one this can read: plain
    words, or a variable given exactly one literal value and never changed
    any other way. Those naming `path` must be `chgrp GROUP PATH` and
    `chmod g+s PATH` with no options, each certain to run (_sure_commands),
    at least one of each, with the chgrps agreeing and no chown. Anything
    else gives None, so the file stays red."""
    parsed = _sure_commands(script)
    if parsed is None:
        return None
    sure_cmds, every = parsed

    values = {}
    for words in every:
        if words[0] in ("local", "export", "readonly", "declare") and len(words) == 2:
            words = words[1:]
        m = _ASSIGN.match(words[0])
        if not m or len(words) != 1:
            continue
        name, value = m.groups()
        literal = value and not any(c in value for c in _UNSAFE)
        if not literal or values.get(name, value) != value:
            values[name] = None
        else:
            values[name] = value

    def resolve(word):
        if not any(c in word for c in _UNSAFE):
            return word
        m = _VAR_REF.match(word)
        if not m:
            return None
        name = m.group(1) or m.group(2)
        # Only `NAME=` may mention the name bare; `NAME+=`, `for NAME`,
        # `read NAME` or `printf -v NAME` change it in ways not tracked here.
        for hit in re.finditer(rf"(?<![A-Za-z0-9_$\{{]){name}(?![A-Za-z0-9_])", script):
            if not script.startswith("=", hit.end()):
                return None
        return values.get(name)

    groups, setgid = set(), 0
    sure_ids = {id(w) for w in sure_cmds}
    for words in every:
        cmd = words[0].rsplit("/", 1)[-1]
        if cmd not in ("chgrp", "chmod", "chown"):
            continue
        args = [resolve(w) for w in words[1:]]
        if None in args:
            return None
        if path not in args:
            continue
        if args[-1] != path or len(args) != 2 or id(words) not in sure_ids:
            return None
        if cmd == "chgrp" and not args[0].startswith("-"):
            groups.add(args[0])
        elif cmd == "chmod" and args[0] == "g+s":
            setgid += 1
        else:
            return None
    if len(groups) != 1 or not setgid:
        return None
    return groups.pop()


def _mtree_entry(owner, version, path):
    """The keywords (mode, uid, gid and so on) of `path` in the package's
    mtree file, with /set defaults applied, or None when it is not there."""
    try:
        with gzip.open(f"/var/lib/pacman/local/{owner}-{version}/mtree", "rt",
                       errors="replace") as f:
            lines = f.read().splitlines()
    except (OSError, EOFError):
        return None
    want = "." + path
    defaults = {}
    for line in lines:
        parts = line.split()
        if not parts or parts[0].startswith("#"):
            continue
        keywords = dict(p.split("=", 1) for p in parts[1:] if "=" in p)
        if parts[0] == "/set":
            defaults.update(keywords)
        elif parts[0] == "/unset":
            for k in parts[1:]:
                defaults.pop(k, None)
        elif re.sub(r"\\([0-7]{3})", lambda m: chr(int(m.group(1), 8)), parts[0]) == want:
            return {**defaults, **keywords}
    return None


def scriptlet_setgid(path):
    """The package whose install script explains a GID and permissions
    mismatch on `path`, or None.

    pacman must report nothing for the file but a GID or permissions
    mismatch, so its content, size and owner are as packaged. The install
    script must give it a group and the setgid bit (scriptlet_setgid_group),
    the file must now be in that group, and its mode must be the packaged
    mode plus setgid and nothing else. spycatcher-scan calls this through
    --scriptlet-setgid, so both use this one check."""
    if os.path.islink(path) or not os.path.isfile(path):
        return None
    owner = (_pacman("-Qqo", "--", path) or "").split("\n")[0].strip()
    version = (_pacman("-Q", "--", owner) or "").split() if owner else []
    if len(version) != 2:
        return None
    # Anything pacman says about the file but a group, mode or time mismatch
    # rules it out. Run as a user who cannot read the file, pacman prints
    # "failed to calculate SHA256 checksum" rather than a checksum mismatch,
    # so a list of bad messages to look for would let that through.
    said = _qkk_said(owner, path)
    if said is None:
        return None
    if any(not re.search(r"\((?:GID|Permissions|Modification time) mismatch\)$", l)
           for l in said):
        return None
    if not any(re.search(r"\((?:GID|Permissions) mismatch\)$", l) for l in said):
        return None
    try:
        group = scriptlet_setgid_group(
            Path(f"/var/lib/pacman/local/{owner}-{version[1]}/install").read_text(), path)
    except (OSError, UnicodeDecodeError):
        return None
    entry = _mtree_entry(owner, version[1], path)
    if group is None or entry is None:
        return None
    try:
        st = os.stat(path)
        mode, uid = int(entry["mode"], 8), int(entry["uid"])
        now_group = grp.getgrgid(st.st_gid).gr_name
    except (OSError, KeyError, ValueError):
        return None
    if now_group != group or st.st_uid != uid or stat.S_IMODE(st.st_mode) != mode | stat.S_ISGID:
        return None
    return owner


def _root_only(st):
    """True when a file is owned by root and nobody else may write it, the
    same test spycatcher-scan applies before it sources scan.conf."""
    return st.st_uid == 0 and not st.st_mode & 0o022


def _conf_pairs(conf, name, value_re):
    """A scan.conf setting written as path=value pairs, as {path: value}.

    The value must be written out literally: a variable, command substitution
    or backslash anywhere in it, or a file that is not root's alone, gives an
    empty list, so nothing is accepted. Entries that are not an absolute path,
    an equals sign and a value matching `value_re` are skipped. The last
    assignment wins, as it does when the file is sourced."""
    if not conf:
        return {}
    try:
        st = os.stat(conf)
        lines = Path(conf).read_text().splitlines()
    except (OSError, UnicodeDecodeError):
        return {}
    if not _root_only(st):
        return {}
    value, i = "", 0
    while i < len(lines):
        m = re.match(rf"\s*(?:export\s+)?{name}=(.*)$", lines[i])
        i += 1
        if not m:
            continue
        chunk = m.group(1)
        while True:
            # A quoted value may run over several lines.
            try:
                words = shlex.split(chunk, comments=True)
                break
            except ValueError:
                if i >= len(lines):
                    return {}
                chunk += "\n" + lines[i]
                i += 1
        if len(words) > 1 or any(c in chunk for c in "$`\\"):
            return {}
        value = words[0] if words else ""
    pairs = {}
    for entry in value.split():
        path, sep, val = entry.rpartition("=")
        if (sep and path.startswith("/") and os.path.normpath(path) == path
                and re.fullmatch(value_re, val)):
            pairs[path] = val
    return pairs


def listed_links(conf=SCAN_CONF):
    """The SCRIPTLET_LINKS setting of scan.conf as {link path: package}, read
    by _conf_pairs(), so a value that is not written out literally lists
    nothing and every link stays red."""
    return _conf_pairs(conf, "SCRIPTLET_LINKS", r"[a-z0-9@_+][a-z0-9@._+-]*")


def _ln_makes(script, link):
    """True when `script` has an `ln -s TARGET LINK` command whose last
    argument is exactly `link`, whatever TARGET is."""
    text = re.sub(r"\\\n", " ", script)
    for line in text.splitlines():
        if not _names_exactly(line, link):
            continue
        for args in _ln_commands(line) or []:
            if link not in args:
                continue
            parsed = _ln_operands(args)
            if (parsed and parsed[0] and len(parsed[1]) == 2
                    and parsed[1][-1] == link):
                return True
    return False


def listed_link_package(path, links):
    """The package a link listed in scan.conf's SCRIPTLET_LINKS belongs to,
    or None. For a package whose install script picks the link's target at
    run time, which scriptlet_link_target() rightly refuses to guess. All of
    these must hold: the path is listed, and is a symlink rather than a file;
    it resolves to a regular file owned by the listed package and no other;
    pacman finds that file unaltered; and the package's install script has an
    `ln -s` command whose last argument is exactly the path. spycatcher-scan
    calls this through --listed-link, so both use this one check."""
    pkg = links.get(path)
    if not pkg or not os.path.islink(path):
        return None
    target = os.path.realpath(path)
    if not os.path.isfile(target):
        return None
    if (_pacman("-Qqo", "--", target) or "").split() != [pkg]:
        return None
    version = (_pacman("-Q", "--", pkg) or "").split()
    if len(version) != 2 or version[0] != pkg:
        return None
    if not _pacman_verifies(pkg, target):
        return None
    try:
        script = Path(f"/var/lib/pacman/local/{pkg}-{version[1]}/install").read_text()
    except (OSError, UnicodeDecodeError):
        return None
    return pkg if _ln_makes(script, path) else None


def listed_link_explains(line, links):
    """True when a RED unpackaged-file line is a link listed in scan.conf
    that listed_link_package() accepts."""
    m = re.match(r"(?:added|changed) (.+) \(unpackaged file in a system code path\)$", line)
    return bool(m and links and listed_link_package(m.group(1), links))


# --- changes made while pacman ran --------------------------------------------
#
# A package's install script, a pacman hook, or a local hook of the
# administrator's may write files that pacman cannot vouch for. Each rule
# below accepts such a file only when its inode change time (ctime) falls
# inside the moment pacman.log records that script or hook running. Unlike the
# modification time, which `touch` can set to anything, the change time is
# set by the kernel whenever the file or its metadata is written, so a file
# edited later, or whose times were reset, falls outside the window and stays
# red.

PACMAN_HOOKS = "/etc/pacman.d/hooks"
_ALPM_LINE = re.compile(r"^\[([^\]]+)\] \[ALPM\] (.*)$")
_PKG_STEP = re.compile(r"(?:installed|upgraded|reinstalled|downgraded) (\S+) \((?:\S+ -> )?(\S+)\)$")
_HOOK_RUN = re.compile(r"running '([^'/]+\.hook)'\.\.\.$")
# The longest an install script is believed to run. A window is otherwise
# closed by the next line pacman logs.
_STEP_MAX = 1800


@functools.lru_cache(maxsize=2)
def _alpm_events(log):
    """Every [ALPM] line of pacman.log as (epoch seconds, message), in order.
    Scriptlet output ([ALPM-SCRIPTLET]) is not included."""
    out = []
    for line in log.splitlines():
        m = _ALPM_LINE.match(line)
        when = _stamp(m.group(1)) if m else None
        if when:
            out.append((when.timestamp(), m.group(2)))
    return out


def _pacman_log(log):
    """`log`, or pacman.log read now when it is None."""
    if log is not None:
        return log
    try:
        return PACMAN_LOG.read_text(errors="replace")
    except OSError:
        return ""


def _package_steps(events, ctime):
    """(package, version) for each package install, upgrade, reinstall or
    downgrade whose step in pacman.log spans `ctime`: from a second before
    its line to two seconds after the next line pacman logged, which closes
    it. pacman logs the step before it runs the install script, and its log
    keeps whole seconds."""
    found = []
    for i, (when, msg) in enumerate(events):
        m = _PKG_STEP.match(msg)
        if not m:
            continue
        end = events[i + 1][0] if i + 1 < len(events) else when
        end = min(end, when + _STEP_MAX)
        if when - 1 <= ctime <= end + 2:
            found.append((m.group(1), m.group(2)))
    return found


def _hook_ran(events, name_ok, ctime, seconds):
    """True when pacman.log records a hook whose file name passes `name_ok`
    starting at most `seconds` before `ctime`, and not after it."""
    for when, msg in events:
        m = _HOOK_RUN.match(msg)
        if m and name_ok(m.group(1)) and when - 1 <= ctime <= when + seconds:
            return True
    return False


def _brace_expand(word, limit=64):
    """`word` with shell brace lists ({a,b}) expanded, at most `limit` words."""
    m = re.search(r"\{([^{}]*,[^{}]*)\}", word)
    if not m:
        return [word]
    out = []
    for part in m.group(1).split(","):
        out.extend(_brace_expand(word[:m.start()] + part + word[m.end():], limit))
        if len(out) >= limit:
            return out[:limit]
    return out


def _is_path(word, path):
    """True when a literal shell word, after brace expansion, is `path`:
    absolute, or relative to / as install scripts run there."""
    for w in _brace_expand(word):
        if not w or "$" in w or "`" in w:
            continue
        w = w[1:] if w.startswith("./") else w
        if not w.startswith("/"):
            w = "/" + w
        if os.path.normpath(w) == path:
            return True
    return False


def _script_lines(script):
    """Each line of a script, continued lines joined, as its list of words
    and operators, or None for a line the splitter cannot read."""
    for line in re.sub(r"\\\n", " ", script).splitlines():
        lex = shlex.shlex(line, posix=True, punctuation_chars=True)
        lex.whitespace_split = True
        lex.commenters = "#"
        try:
            yield line, list(lex)
        except ValueError:
            yield line, None


def _script_names(script, path):
    """True when an install script mentions `path` as a word of its own, in
    any command, assignment or brace list. Comments do not count. This says
    only that the script knows the file, not that it writes it."""
    for line, words in _script_lines(script):
        if words is None:
            # A line the splitter cannot read still counts when it holds the
            # path outside a comment.
            if _names_exactly(line.split("#", 1)[0], path):
                return True
            continue
        for word in words:
            m = _ASSIGN.match(word)
            if _is_path(m.group(2) if m else word, path):
                return True
    return False


def _script_values(script):
    """{NAME: value} for every variable an install script assigns one
    unchanging value (NAME=value, or after local, export, readonly or
    declare). A variable assigned two different values is None."""
    values = {}
    for _, words in _script_lines(script):
        for i, word in enumerate(words or []):
            if i and words[i - 1] not in ("local", "export", "readonly", "declare", ";", "&&",
                                          "||", "then", "do", "{", "(") and i != 0:
                continue
            m = _ASSIGN.match(word)
            if m:
                name, value = m.groups()
                values[name] = value if values.get(name, value) == value else None
    return values


def _resolve(word, values, depth=0):
    """A shell word as the literal it stands for: itself when it has no
    expansion, the value of a plain "$NAME" or "${NAME}", or the default of a
    positional "${1:-WORD}". Anything else is None."""
    if depth > 5 or word is None:
        return None
    if not any(c in word for c in "$`"):
        return word
    m = re.fullmatch(r"\$(?:([A-Za-z_][A-Za-z0-9_]*)|\{([A-Za-z_][A-Za-z0-9_]*)\})", word)
    if m:
        return _resolve(values.get(m.group(1) or m.group(2)), values, depth + 1)
    m = re.fullmatch(r"\$\{[0-9]:?-(.*)\}", word)
    if m:
        return _resolve(m.group(1), values, depth + 1)
    return None


# Commands whose last operand is the file they write, and commands that
# write every file they are given.
_WRITE_LAST = {"cp", "mv", "install", "ln"}
_WRITE_ALL = {"touch", "tee", "truncate"}
_REDIRECT = {">", ">>", ">|", "&>", "&>>"}


def _script_writes(script, path):
    """True when an install script writes `path`: as the target of a
    redirection (>, >>), the last operand of cp, mv, install or ln, an
    operand of touch, tee or truncate, a file edited by sed -i, or dd's of=.
    The word may be a literal, or a variable the script gives one literal
    value (see _resolve). A path the script only removes, tests or passes
    to some other program does not count."""
    values = _script_values(script)

    def hit(word):
        return _is_path(_resolve(word, values) or "", path)

    for _, tokens in _script_lines(script):
        if tokens is None:
            continue
        words = []
        for i, tok in enumerate(tokens + [";"]):
            if tok in _REDIRECT and i + 1 < len(tokens) and hit(tokens[i + 1]):
                return True
            if tok and all(c in "();<>|&" for c in tok):
                while words and words[0] in _LN_LEAD:
                    words.pop(0)
                if words and _command_writes(words, hit):
                    return True
                words = []
            elif not (i and tokens[i - 1] in _REDIRECT):
                words.append(tok)
    return False


def _command_writes(words, hit):
    cmd, args = words[0].rsplit("/", 1)[-1], words[1:]
    operands = [a for a in args if not a.startswith("-")]
    if cmd in _WRITE_LAST:
        if cmd == "install" and ("-d" in args or "--directory" in args):
            return any(hit(a) for a in operands)
        return len(operands) >= 2 and hit(operands[-1])
    if cmd in _WRITE_ALL:
        return any(hit(a) for a in operands)
    if cmd == "sed" and any(a == "--in-place" or re.fullmatch(r"-[a-zA-Z]*i\S*", a) for a in args):
        scripted = any(a in ("-e", "-f") or a.startswith(("--expression", "--file")) for a in args)
        return any(hit(a) for a in (operands if scripted else operands[1:]))
    if cmd == "dd":
        return any(a.startswith("of=") and hit(a[3:]) for a in args)
    return False


def _install_script(pkg, version):
    try:
        return Path(f"/var/lib/pacman/local/{pkg}-{version}/install").read_text()
    except (OSError, UnicodeDecodeError):
        return None


def prefetch_owners(paths):
    """Asks pacman who owns each of `paths`, and each symlink's target, in
    one call, and keeps the answers for _owner_of(). The paths go on standard
    input, never the command line."""
    if _PACMAN_CACHE is None:
        return
    want = set()
    for path in paths:
        if path.startswith("/") and not _UNSAFE_CHARS.search(path) and "\t" not in path:
            want.add(path)
            if os.path.islink(path):
                want.add(os.path.realpath(path))
    want = sorted(p for p in want if ("-Qqo", "--", p) not in _PACMAN_CACHE)
    if not want:
        return
    try:
        r = subprocess.run([_tool("pacman"), "-Qo", "-"], input="".join(f"{p}\n" for p in want),
                           capture_output=True, text=True, timeout=120, env=_C_LOCALE)
    except (OSError, subprocess.SubprocessError):
        return
    # pacman prints the path with its parent folder resolved, so an answer
    # is kept only for a path it prints exactly as asked, or names in "No
    # package owns". Any other path is left to a -Qqo of its own.
    owners, unowned = {}, set()
    for line in r.stdout.splitlines():
        m = re.match(r"(.*) is owned by (\S+) \S+$", line)
        if m:
            owners.setdefault(m.group(1), []).append(m.group(2))
    for line in r.stderr.splitlines():
        m = re.match(r"error: No package owns (.*)$", line)
        if m:
            unowned.add(m.group(1))
    for p in want:
        if p in owners:
            _PACMAN_CACHE[("-Qqo", "--", p)] = "".join(f"{o}\n" for o in owners[p])
        elif p in unowned:
            _PACMAN_CACHE[("-Qqo", "--", p)] = None


def _owner_of(path):
    """The first package that owns `path`, or "" when none does."""
    return (_pacman("-Qqo", "--", path) or "").split("\n")[0].strip()


PKG, MAYBE = "PKG", "AMBER"


def scriptlet_wrote(path, owner=None, log=None):
    """(package, grade) when `path` was written by that package's own install
    script, or None. grade is PKG when the script has a command that writes
    the path, AMBER when the script only names it (graphviz removes
    usr/lib/graphviz/config8 and has `dot -c` write it again).

    Some install scripts write files pacman cannot vouch for: graphviz's
    plugin list, a voice typing tool's link /usr/bin/<name> to the build for
    this CPU, 1password's polkit policy, edited with sed on every upgrade.
    All of these must hold:

    - the file, or the symlink itself, was last changed while pacman.log shows
      that package being installed or upgraded, to the version installed now;
    - that version's install script writes or names the file's exact path;
    - with `owner` given (a file the package owns that fails pacman's
      checksum), pacman reports nothing for it but a content, size or time
      mismatch, so its type, mode and owner are as packaged;
    - without `owner` (a file no package owns), no package owns it now, and a
      symlink must point at a file of that same package that pacman verifies.

    Limit: the content of such a file cannot be checked against anything. The
    change time (ctime) is set by the kernel and cannot be set back without
    changing the clock, so the file was written while the package's step ran,
    but a program already running as root could write it in that moment
    too. A file changed at any other moment stays red."""
    try:
        st = os.lstat(path)
    except OSError:
        return None
    if not (stat.S_ISREG(st.st_mode) or stat.S_ISLNK(st.st_mode)):
        return None
    events = _alpm_events(_pacman_log(log))
    for pkg, version in _package_steps(events, st.st_ctime):
        if owner is not None and pkg != owner:
            continue
        if (_pacman("-Q", "--", pkg) or "").split() != [pkg, version]:
            continue
        script = _install_script(pkg, version)
        if script is None:
            continue
        grade = PKG if _script_writes(script, path) else MAYBE if _script_names(script, path) else None
        if grade is None:
            continue
        if owner is not None:
            if _owner_of(path) != owner or not _content_only(owner, path):
                continue
        else:
            if _owner_of(path):
                continue
            if stat.S_ISLNK(st.st_mode):
                target = os.path.realpath(path)
                if (not os.path.isfile(target) or _owner_of(target) != pkg
                        or not _pacman_verifies(pkg, target)):
                    continue
        return pkg, grade
    return None


_HASHES = r"[0-9a-f]{64}(?:,[0-9a-f]{64})*"


def hook_patched_entries(conf=SCAN_CONF):
    """The HOOK_PATCHED setting of scan.conf as {file path: (hook file name,
    set of SHA-256 sums)}: package files that a pacman hook of this
    machine's own, in /etc/pacman.d/hooks, deliberately patches after each
    upgrade, written as path=name.hook:sha256[,sha256...]. The sums are those
    of the file as patched; an entry without one is skipped. Read by
    _conf_pairs(), so only a literal value counts."""
    pairs = _conf_pairs(conf, "HOOK_PATCHED",
                        rf"[A-Za-z0-9@_+][A-Za-z0-9@._+-]*\.hook:{_HASHES}")
    return {path: (v.split(":")[0], set(v.split(":")[1].split(","))) for path, v in pairs.items()}


def _sha256(path):
    h = hashlib.sha256()
    try:
        with open(path, "rb") as f:
            for chunk in iter(lambda: f.read(1 << 20), b""):
                h.update(chunk)
    except OSError:
        return None
    return h.hexdigest()


def hook_patched(path, owner, conf=SCAN_CONF, log=None):
    """The package of a file listed in HOOK_PATCHED whose checksum failure
    the listed hook explains, or None. All of these must hold: the file is
    listed with that hook; its content is one of the listed SHA-256 sums; the
    hook file is in /etc/pacman.d/hooks, a regular file owned by root that no
    one else may write; the file is a regular file `owner` owns, and pacman
    reports nothing for it but a content, size or time mismatch; and the
    file was last changed within a minute of pacman.log recording that hook
    running. A patch applied any other way, other content, or a later edit
    stays red. When the package changes the file upstream, the patched file
    changes too and stays red until its new sum is listed."""
    hook, sums = hook_patched_entries(conf).get(path, (None, set()))
    if not hook:
        return None
    try:
        hst = os.lstat(os.path.join(PACMAN_HOOKS, hook))
        st = os.lstat(path)
    except OSError:
        return None
    if not stat.S_ISREG(hst.st_mode) or not _root_only(hst) or not stat.S_ISREG(st.st_mode):
        return None
    if _sha256(path) not in sums:
        return None
    if _owner_of(path) != owner or not _content_only(owner, path):
        return None
    events = _alpm_events(_pacman_log(log))
    return owner if _hook_ran(events, lambda name: name == hook, st.st_ctime, 60) else None


_MODULE_INDEX = re.compile(r"/usr/lib/modules/([A-Za-z0-9][A-Za-z0-9._+-]*)/(modules\.[A-Za-z0-9_.]+)")
# The files depmod writes. modules.builtin, modules.order and
# modules.builtin.modinfo come with the kernel package.
DEPMOD_FILES = ("modules.alias", "modules.alias.bin", "modules.builtin.alias.bin",
                "modules.builtin.bin", "modules.dep", "modules.dep.bin", "modules.devname",
                "modules.softdep", "modules.symbols", "modules.symbols.bin", "modules.weakdep")
MODULES = "/usr/lib/modules"
_DEPMOD_SUMS = {}


def _depmod_sums(version):
    """{file name: SHA-256} of the index depmod builds now for kernel
    `version`, or None. It runs in a temporary folder that links to every
    entry of the real module folder except depmod's own files, so nothing on
    the system is written. Built once per version and run."""
    if version in _DEPMOD_SUMS:
        return _DEPMOD_SUMS[version]
    sums = None
    src = os.path.join(MODULES, version)
    try:
        with tempfile.TemporaryDirectory() as tmp:
            dest = os.path.join(tmp, "lib/modules", version)
            os.makedirs(dest)
            for name in os.listdir(src):
                if name not in DEPMOD_FILES:
                    os.symlink(os.path.join(src, name), os.path.join(dest, name))
            r = subprocess.run([_tool("depmod"), "-b", tmp, version], capture_output=True,
                               timeout=300, env=_C_LOCALE)
            if r.returncode == 0:
                sums = {n: _sha256(os.path.join(dest, n)) for n in DEPMOD_FILES
                        if os.path.isfile(os.path.join(dest, n))}
    except (OSError, subprocess.SubprocessError):
        sums = None
    _DEPMOD_SUMS[version] = sums
    return sums


def depmod_rebuilt(path, log=None):
    """The package of the kernel whose module index `path` is, when the file
    holds exactly what depmod builds from the modules installed now, or None.
    depmod writes modules.dep, modules.alias and the rest into
    /usr/lib/modules/<version>/ after every kernel or module change, and no
    package owns them. The file must be a regular file directly in a module
    folder that an installed package owns, and byte for byte what depmod
    writes when run again into a temporary folder. The modules themselves are
    checked as package files. `log` is unused and kept for the callers."""
    m = _MODULE_INDEX.fullmatch(path)
    if not m or m.group(2) not in DEPMOD_FILES:
        return None
    try:
        st = os.lstat(path)
    except OSError:
        return None
    if not stat.S_ISREG(st.st_mode):
        return None
    kernel = _owner_of(f"{MODULES}/{m.group(1)}/")
    if not kernel:
        return None
    sums = _depmod_sums(m.group(1))
    if not sums or sums.get(m.group(2)) is None or sums[m.group(2)] != _sha256(path):
        return None
    return kernel


def old_kernel_modules(version):
    """True when /usr/lib/modules/<version> is the module folder of a kernel
    that is no longer installed: the folder is gone, no installed package
    owns it, and it is not the running kernel's. A kernel upgrade keeps the
    running kernel's modules until the next boot (kernel-modules-hook), so its
    files are deleted later, outside any pacman run. Removing modules of a
    kernel that cannot boot adds no code to the machine."""
    if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._+-]*", version) or version == os.uname().release:
        return False
    folder = f"/usr/lib/modules/{version}"
    if os.path.lexists(folder):
        return False
    # pacman exits 1 for a path no package owns, which _pacman reads as None.
    return _pacman("-Qqo", "--", folder + "/") is None


_DKMS_MODULE = re.compile(r"/usr/lib/modules/([A-Za-z0-9][A-Za-z0-9._+-]*)/updates/dkms/"
                          r"([A-Za-z0-9][A-Za-z0-9_-]*\.ko(?:\.zst|\.xz|\.gz)?)")
_DKMS_NAME = re.compile(r"[A-Za-z0-9][A-Za-z0-9._+-]*")
DKMS_TREE = "/var/lib/dkms"
DKMS_SOURCES = "/usr/src"
# The hook the dkms package installs; it builds every module for every
# installed kernel after a kernel, headers or *-dkms package changes.
DKMS_HOOK = "70-dkms-install.hook"


def _hook_window(events, name, ctime):
    """True when `ctime` falls while the hook `name` ran: from a second before
    pacman.log records it starting to two seconds after the next line pacman
    logged, at most _STEP_MAX seconds. pacman logs nothing while a hook runs,
    and a DKMS build for one kernel takes minutes."""
    for i, (when, msg) in enumerate(events):
        m = _HOOK_RUN.match(msg)
        if not m or m.group(1) != name:
            continue
        end = events[i + 1][0] if i + 1 < len(events) else when + _STEP_MAX
        end = min(end, when + _STEP_MAX)
        if when - 1 <= ctime <= end + 2:
            return True
    return False


_TRANSACTION_START = "transaction started"


@functools.lru_cache(maxsize=2)
def _pacman_runs(log):
    """(start, end) in epoch seconds for each pacman run in pacman.log text
    `log`. A run starts at `transaction started`, or at the pre-transaction
    hooks pacman logs just before it, and ends at the last [ALPM] line it
    logged: the post-transaction hooks follow `transaction completed`, and
    the last of them may run for minutes without a line, as a DKMS build
    does. The next `transaction started`, or a gap of more than _STEP_MAX
    seconds between two lines, closes a run. Neither kind of hook says which
    it is, so where one run's post-transaction hooks meet the next run's
    pre-transaction hooks, the order of their names decides: pacman runs each
    set sorted by file name, so the next run starts where the names begin
    again from a lower one. A hook put on the wrong side still lies inside one
    of the two runs."""
    events = _alpm_events(log)
    starts = [i for i, (_, msg) in enumerate(events) if msg == _TRANSACTION_START]
    begins = []
    for s in starts:
        b = s
        while b > 0 and (not begins or b - 1 > begins[-1][1]):
            m = _HOOK_RUN.match(events[b - 1][1])
            if not m or events[b][0] - events[b - 1][0] > _STEP_MAX:
                break
            later = _HOOK_RUN.match(events[b][1])
            if later and m.group(1) > later.group(1):
                break
            b -= 1
        begins.append((b, s))
    runs = []
    for k, (b, s) in enumerate(begins):
        stop = begins[k + 1][0] if k + 1 < len(begins) else len(events)
        e = s
        while e + 1 < stop and events[e + 1][0] - events[e][0] <= _STEP_MAX:
            e += 1
        runs.append((events[b][0], events[e][0]))
    return runs


def pacman_run_at(ctime, log=None):
    """(start, end) of the pacman run whose span, from a second before its
    first line to two seconds after its last, holds `ctime`, or None. pacman
    keeps whole seconds, and a hook's last write may land just after the
    line that closes it. `log` is pacman.log's text, read now when None."""
    for start, end in _pacman_runs(_pacman_log(log)):
        if start - 1 <= ctime <= end + 2:
            return start, end
    return None


# The folders whose unpackaged files spycatcher-scan grades by place rather
# than as system code: /boot by the package update count, the others amber.
_NOT_SYSTEM_CODE = ("/boot/", "/usr/local/", "/opt/", "/etc/", "/root/", "/home/")


def written_in_pacman_run(path, log=None):
    """The start of the pacman run during which the unpackaged file at
    `path` (or the link itself) last changed, as an aware datetime, or None.
    This is the rule of last resort for a file in a system code path that no
    other rule explains: no package vouches for it, but its change time puts
    it inside a package update, when hooks and install scripts write such
    files, so it is graded for the administrator to confirm rather than red.
    A file written outside every run stays red. The change time cannot be
    set back into a past run without changing the clock, but a program
    already running as root that writes during a real update gets the same
    amber."""
    if path.startswith(_NOT_SYSTEM_CODE):
        return None
    try:
        st = os.lstat(path)
    except OSError:
        return None
    run = pacman_run_at(st.st_ctime, log)
    return dt.datetime.fromtimestamp(run[0]).astimezone() if run else None


def _in_run_reason(start):
    """The reason spycatcher-scan logs for a file written_in_pacman_run()
    accepts."""
    return (f"appeared during the package update of {start:%a %d %b %H:%M}, "
            "which no rule explains; confirm")


def _root_dir(path):
    """True when `path` itself, not a link to it, is a folder owned by root
    that no one else may write."""
    try:
        st = os.lstat(path)
    except OSError:
        return False
    return stat.S_ISDIR(st.st_mode) and _root_only(st)


def _source_verified(owner, folder):
    """True when `folder` is reached without a link and pacman -Qkk `owner`
    finds nothing wrong with any file in it."""
    if os.path.realpath(folder) != folder:
        return False
    out = _qkk(owner)
    if out is None or re.search(rf"^{re.escape(owner)}: no mtree file$", out, re.M):
        return False
    inside = f" {folder}/"
    return not any(inside in l and (_QKK_BAD.search(l) or "failed to calculate" in l)
                   for l in out.splitlines())


def dkms_built(path, log=None):
    """The package whose DKMS source built the kernel module at `path`, or
    None. dkms installs the modules it builds into
    /usr/lib/modules/<kernel>/updates/dkms/, which no package owns. All of
    these must hold: the module is a regular file there, for a kernel whose
    module folder an installed package owns; it is byte for byte the copy
    dkms keeps of its build in /var/lib/dkms/<name>/<version>/<kernel>/,
    a regular file owned by root that no one else may write, reached through
    folders that are no links and are root's alone; the source it was built
    from, /usr/src/<name>-<version>/, is reached without a link, its
    dkms.conf belongs to an installed package, and pacman verifies every
    file of that package in the folder; and the module was last changed
    while pacman ran the dkms hook. A module copied in by hand, or changed
    after the build, stays red. AIDE does not watch /var/lib/dkms, so the
    build copy is no independent witness: a program already running as root
    could write both copies and a hook line in pacman.log, the same gap as
    scriptlet_wrote() and hook_patched() have."""
    m = _DKMS_MODULE.fullmatch(path)
    if not m:
        return None
    kernel, name = m.groups()
    try:
        st = os.lstat(path)
    except OSError:
        return None
    if not stat.S_ISREG(st.st_mode) or not _owner_of(f"{MODULES}/{kernel}/"):
        return None
    if not _hook_window(_alpm_events(_pacman_log(log)), DKMS_HOOK, st.st_ctime):
        return None
    sha = None
    if not _root_dir(DKMS_TREE):
        return None
    try:
        modules = sorted(os.listdir(DKMS_TREE))
    except OSError:
        return None
    for module in modules:
        try:
            versions = sorted(os.listdir(os.path.join(DKMS_TREE, module)))
        except OSError:
            continue
        for version in versions:
            if not _DKMS_NAME.fullmatch(module) or not _DKMS_NAME.fullmatch(version):
                continue
            kept = os.path.join(DKMS_TREE, module, version, kernel)
            if not all(_root_dir(d) for d in (os.path.join(DKMS_TREE, module),
                                              os.path.join(DKMS_TREE, module, version), kept)):
                continue
            try:
                arches = sorted(os.listdir(kept))
            except OSError:
                continue
            for arch in arches:
                folder = os.path.join(kept, arch, "module")
                if not _root_dir(os.path.join(kept, arch)) or not _root_dir(folder):
                    continue
                copy = os.path.join(folder, name)
                try:
                    cst = os.lstat(copy)
                except OSError:
                    continue
                if not stat.S_ISREG(cst.st_mode) or not _root_only(cst):
                    continue
                if sha is None:
                    sha = _sha256(path)
                if sha is None or _sha256(copy) != sha:
                    continue
                source = os.path.join(DKMS_SOURCES, f"{module}-{version}")
                pkg = _owner_of(os.path.join(source, "dkms.conf"))
                if pkg and _source_verified(pkg, source):
                    return pkg
    return None


MOUNTINFO = "/proc/self/mountinfo"
# File systems that keep no Unix mode or owner: every file gets those the
# mount options give it.
NO_UNIX_MODES = {"vfat", "msdos", "exfat", "ntfs", "ntfs3"}


def _mount_of(path):
    """(mount point, file system type, super options as a dict) of the mount
    `path` is on, by the longest mount point that holds it, or None. Of
    mounts stacked on one mount point, the last listed is the one in use."""
    best = None
    try:
        lines = Path(MOUNTINFO).read_text().splitlines()
    except OSError:
        return None
    for line in lines:
        left, sep, right = line.partition(" - ")
        fields, rest = left.split(), right.split()
        if not sep or len(fields) < 5 or len(rest) < 3:
            continue
        point = fields[4].replace("\\040", " ")
        inside = path == point or path.startswith(point.rstrip("/") + "/")
        if inside and (best is None or len(point) >= len(best[0])):
            opts = dict(o.partition("=")[::2] for o in rest[2].split(","))
            best = (point, rest[0], opts)
    return best


def _packaged(owner, path):
    """The mode, uid and gid the package gives `path`, from its mtree file,
    or None."""
    version = (_pacman("-Q", "--", owner) or "").split()
    if len(version) != 2:
        return None
    entry = _mtree_entry(owner, version[1], path)
    try:
        return (int(entry["mode"], 8), int(entry.get("uid", "0")), int(entry.get("gid", "0")))
    except (TypeError, KeyError, ValueError):
        return None


def mount_mode_explains(path, owner):
    """The package of a file on a file system without Unix modes (FAT, exFAT,
    NTFS) whose only faults are a mode, owner or group that the mount gives
    every file, or None. /boot is often FAT with fmask=0077, so each packaged
    file there is 0700 root and pacman reports a permissions mismatch for it
    after every upgrade. pacman must report nothing else for the file, its
    content included; the file's mode, owner and group must be exactly what
    the mount options give a file (fmask, or umask) or a folder (dmask, or
    umask), uid and gid; and those must be safe: owned by root, in group root
    or the packaged group, writable by no group or other, and with no
    permission the package does not give, apart from the execute bits FAT
    gives every file. A mount that hands the files to a user, or makes them
    writable by others, stays red."""
    mount = _mount_of(path)
    if not mount or mount[1] not in NO_UNIX_MODES:
        return None
    try:
        st = os.lstat(path)
    except OSError:
        return None
    opts = mount[2]
    if stat.S_ISDIR(st.st_mode):
        mask = opts.get("dmask", opts.get("umask", "022"))
    elif stat.S_ISREG(st.st_mode):
        mask = opts.get("fmask", opts.get("umask", "022"))
    else:
        return None
    try:
        want_mode = 0o777 & ~int(mask, 8)
        want_uid, want_gid = int(opts.get("uid", "0")), int(opts.get("gid", "0"))
    except ValueError:
        return None
    mode = stat.S_IMODE(st.st_mode)
    if (mode != want_mode or st.st_uid != want_uid or st.st_gid != want_gid
            or _owner_of(path) != owner):
        return None
    packaged = _packaged(owner, path)
    if packaged is None:
        return None
    if (st.st_uid != 0 or st.st_gid not in (0, packaged[2]) or mode & 0o022
            or mode & ~(packaged[0] | 0o111) & 0o7777):
        return None
    said = _qkk_said(owner, path)
    ok = re.compile(r"\((?:Permissions|UID|GID|Modification time) mismatch\)$")
    if said is None or not all(ok.search(l) for l in said):
        return None
    return owner


def _backup_files(owner):
    """The paths package `owner` lists as backup files (configuration it
    keeps across upgrades), from the %BACKUP% section of its entry in
    pacman's local database."""
    version = (_pacman("-Q", "--", owner) or "").split()
    if len(version) != 2:
        return set()
    try:
        text = Path(f"/var/lib/pacman/local/{owner}-{version[1]}/files").read_text()
    except (OSError, UnicodeDecodeError):
        return set()
    m = re.search(r"^%BACKUP%\n(.*?)(?:\n\n|\Z)", text, re.M | re.S)
    return {"/" + line.split("\t")[0] for line in m.group(1).splitlines()} if m else set()


def config_mode_tightened(path, owner):
    """The package of a configuration file it keeps across upgrades (a backup
    file) whose only faults are a mode that only takes permissions away from
    the packaged one and, maybe, another group, or None. cupsd rewrites
    printers.conf 0600 root:cups, which may hold passwords. The file must
    still be owned by root. Any permission the package does not give, or
    another owner, stays red. Graded amber, like an edited configuration
    file. pacman 7 marks only a backup file's content, size and time
    messages "backup file:"; a mode or group mismatch is a plain "warning:",
    so the backup list comes from pacman's database."""
    try:
        st = os.lstat(path)
    except OSError:
        return None
    if not stat.S_ISREG(st.st_mode) or st.st_uid != 0 or _owner_of(path) != owner:
        return None
    if path not in _backup_files(owner):
        return None
    packaged = _packaged(owner, path)
    if packaged is None or stat.S_IMODE(st.st_mode) & ~packaged[0] & 0o7777:
        return None
    said = _qkk_said(owner, path)
    ok = re.compile(r"^(?:warning|backup file): .*\((?:Permissions|GID|Modification time) mismatch\)$")
    if not said or not all(ok.search(l) for l in said):
        return None
    return owner


# Caches that a pacman hook rebuilds whenever a package adds to them. No
# package owns them. Each is explained only when it is byte for byte what its
# tool builds now, run as this user into a temporary folder.
# GIO's own module cache and GTK 4's.
GIO_CACHE = re.compile(r"/usr/lib/gio/modules/giomodule\.cache|/usr/lib/gtk-4\.0/4\.0\.0/[^/]+/giomodule\.cache")


def _links_to(src, tmp, keep):
    """Links in `tmp` to every entry of folder `src` for which `keep` is
    true."""
    for name in os.listdir(src):
        if keep(name):
            os.symlink(os.path.join(src, name), os.path.join(tmp, name))


def _cache_now(path):
    """The bytes the cache's own tool builds now for `path`, or None."""
    run_ = lambda cmd: subprocess.run(cmd, capture_output=True, timeout=120, env=_C_LOCALE)
    try:
        with tempfile.TemporaryDirectory() as tmp:
            if path == "/usr/lib/gconv/gconv-modules.cache":
                out = os.path.join(tmp, "gconv-modules.cache")
                if run_([_tool("iconvconfig"), "-o", out]).returncode == 0:
                    return Path(out).read_bytes()
            elif path == "/usr/lib32/gconv/gconv-modules.cache":
                # As lib32-glibc's pacman hook runs it.
                out = os.path.join(tmp, "gconv-modules.cache")
                if run_([_tool("iconvconfig"), "--nostdlib", f"--output={out}",
                         "/usr/lib32/gconv"]).returncode == 0:
                    return Path(out).read_bytes()
            elif path == "/usr/lib/udev/hwdb.bin":
                # systemd-hwdb follows links inside its --root, so the sources
                # are copied, not linked: every folder it reads them from.
                for folder in HWDB_SOURCES:
                    dest = os.path.join(tmp, folder.lstrip("/"))
                    os.makedirs(dest)
                    if os.path.isdir(folder):
                        for name in os.listdir(folder):
                            src = os.path.join(folder, name)
                            if name.endswith(".hwdb") and os.path.isfile(src):
                                shutil.copyfile(src, os.path.join(dest, name))
                if run_([_tool("systemd-hwdb"), f"--root={tmp}/", "--usr", "update"]).returncode == 0:
                    return Path(tmp, "usr/lib/udev/hwdb.bin").read_bytes()
            elif path == "/usr/lib/gtk-3.0/3.0.0/immodules.cache":
                # Run by its full path, as the pacman hook does: the tool
                # writes how it was called into the cache.
                r = run_([_tool("gtk-query-immodules-3.0")])
                if r.returncode == 0:
                    # On standard output it ends with one more new line.
                    return r.stdout[:-1] if r.stdout.endswith(b"\n\n") else r.stdout
            elif path == "/usr/share/applications/mimeinfo.cache":
                _links_to(os.path.dirname(path), tmp, lambda n: n != "mimeinfo.cache")
                if run_([_tool("update-desktop-database"), tmp]).returncode == 0:
                    return Path(tmp, "mimeinfo.cache").read_bytes()
            elif GIO_CACHE.fullmatch(path):
                _links_to(os.path.dirname(path), tmp, lambda n: n.endswith(".so"))
                if run_([_tool("gio-querymodules"), tmp]).returncode == 0:
                    return Path(tmp, "giomodule.cache").read_bytes()
    except (OSError, subprocess.SubprocessError):
        return None
    return None


# Where systemd-hwdb reads its sources.
HWDB_SOURCES = ("/etc/udev/hwdb.d", "/run/udev/hwdb.d", "/usr/local/lib/udev/hwdb.d",
                "/usr/lib/udev/hwdb.d")
REBUILT_BY = {
    "/usr/lib/gconv/gconv-modules.cache": "iconvconfig",
    "/usr/lib32/gconv/gconv-modules.cache": "iconvconfig",
    "/usr/lib/udev/hwdb.bin": "systemd-hwdb",
    "/usr/lib/gtk-3.0/3.0.0/immodules.cache": "gtk-query-immodules-3.0",
    "/usr/share/applications/mimeinfo.cache": "update-desktop-database",
}


def rebuilt_by_hook(path, log=None):
    """The tool that builds the cache at `path` (glibc's and lib32-glibc's gconv
    modules, systemd's hardware database, GTK 3
    input methods, the desktop MIME cache, a GTK 4 GIO module cache), when
    the file is a regular file and byte for byte what that tool builds now,
    or None. Their pacman hooks run those tools after every change to what
    the caches list. `log` is unused and kept for the callers."""
    tool = REBUILT_BY.get(path) or ("gio-querymodules" if GIO_CACHE.fullmatch(path) else None)
    if tool is None:
        return None
    try:
        st = os.lstat(path)
        data = Path(path).read_bytes() if stat.S_ISREG(st.st_mode) else None
    except OSError:
        return None
    return tool if data is not None and data == _cache_now(path) else None


def explain_changes(records, conf, log):
    """For spycatcher-scan: the explanations above, for many files in one run.
    `records` are (owner, path) pairs; owner is "" for a file no package
    owns, else the package whose checksum the file fails. Yields (path,
    grade, reason) for each file one of them explains, grade PKG or AMBER,
    with the reason worded for the AIDE log."""
    links = listed_links(conf) if conf else {}
    for owner, path in records:
        if owner:
            pkg = config_mode_tightened(path, owner)
            if pkg:
                yield path, MAYBE, f"config file of {pkg}, permissions changed locally"
                continue
            pkg = mount_mode_explains(path, owner)
            if pkg:
                yield path, PKG, (f"{pkg}, verified by pacman; its mode and owner are those the "
                                  f"{_mount_of(path)[1]} file system gives every file")
                continue
            pkg = hook_patched(path, owner, conf, log)
            if pkg:
                yield path, PKG, f"{pkg}, patched by this machine's own hook as listed in scan.conf"
                continue
            found = scriptlet_wrote(path, owner, log)
            if found and found[1] == PKG:
                yield path, PKG, f"{found[0]}, edited by its own install script while pacman installed it"
            elif found:
                yield path, MAYBE, (f"{found[0]}, changed while its install script ran, which names "
                                    "the file but has no command that writes it; confirm")
            continue
        tool = rebuilt_by_hook(path, log)
        if tool:
            yield path, PKG, f"cache the same as {tool} builds it now"
            continue
        pkg = scriptlet_link_package(path)
        if pkg:
            yield path, PKG, (f"link made by {pkg}'s install script, to the file it names, "
                              "which pacman verifies")
            continue
        pkg = listed_link_package(path, links)
        if pkg:
            yield path, PKG, (f"link listed in scan.conf for {pkg}, made by its install script, "
                              "to a file pacman verifies")
            continue
        pkg = depmod_rebuilt(path, log)
        if pkg:
            yield path, PKG, f"module index for {pkg}, the same as depmod builds it now"
            continue
        pkg = dkms_built(path, log)
        if pkg:
            yield path, PKG, f"kernel module dkms built from {pkg} while pacman ran its hook"
            continue
        found = scriptlet_wrote(path, None, log)
        if found and found[1] == PKG:
            yield path, PKG, f"written by {found[0]}'s install script while pacman installed it"
        elif found:
            yield path, MAYBE, (f"written while {found[0]}'s install script ran, which names the "
                                "file but has no command that writes it; confirm")
        else:
            # Last, so that any rule that can name the package is preferred.
            start = written_in_pacman_run(path, log)
            if start:
                yield path, MAYBE, _in_run_reason(start)


def owned_all_along(path, when):
    """True when a file logged as unpackaged by the run that started at
    `when` is a package's file that pacman verifies now, and has not changed
    since before that run, so the run saw this same file. Before 0.2.12 the
    scan asked pacman about each file while a package update could be
    replacing pacman's own libraries; pacman then failed, and its files read
    as unpackaged. pacman cannot take over a file that is already there
    without replacing it, which would have changed it."""
    try:
        st = os.lstat(path)
    except OSError:
        return False
    if st.st_ctime >= when.timestamp():
        return False
    owner = _owner_of(path)
    return bool(owner) and _pacman_verifies(owner, path)


def unchanged_since(path, until):
    """True when `path` (or the symlink itself) last changed before `until`,
    the start of the run that logged it, so a re-check today looks at what
    that run saw rather than at a file written since, or while it ran."""
    try:
        return os.lstat(path).st_ctime < until.timestamp()
    except OSError:
        return False


def unpackaged_explains(line, links, log, when=None, until=None, current=False):
    """The grade (PKG or AMBER) a RED line earns now from the rules above, or
    None. `when` and `until` are the start and end of the run that logged it.
    The file must not have changed since that run ended; a file written since
    is not what the run saw. A line from a run that already used these rules
    (`current`) is only re-checked against scan.conf, whose lists the
    administrator may have added to since."""
    m = re.match(r"(?:added|changed) (.+) \(unpackaged file in a system code path\)$", line)
    if m:
        path = m.group(1)
        if current or until is None or not unchanged_since(path, until):
            return None
        if when is not None and owned_all_along(path, when):
            return PKG
        if rebuilt_by_hook(path, log) or depmod_rebuilt(path, log) or dkms_built(path, log):
            return PKG
        found = scriptlet_wrote(path, None, log)
        if found:
            return found[1]
        return MAYBE if written_in_pacman_run(path, log) else None
    m = re.match(r"(?:added|changed) (.+) \(owned by (\S+) but fails pacman's ownership or "
                 r"permission check\)$", line)
    if m:
        path, owner = m.groups()
        if current or until is None or not unchanged_since(path, until):
            return None
        return PKG if mount_mode_explains(path, owner) else None
    m = re.match(r"changed (.+) \(owned by (\S+) but fails pacman's checksum\)$", line)
    if m:
        path, owner = m.groups()
        if until is None or not unchanged_since(path, until):
            return None
        if hook_patched(path, owner, SCAN_CONF, log):
            return PKG
        if current:
            return None
        found = scriptlet_wrote(path, owner, log)
        return found[1] if found else None
    return None


# limine-snapper-sync keeps a "Snapshots" sub-menu in limine.conf and its own
# record of it in limine_history/snapshots.json, and rewrites both whenever
# snapper creates or removes a snapshot, with or without a package update.
LIMINE_CONF = "/boot/limine.conf"
LIMINE_SYNC_EXE = "/usr/lib/limine/limine-snapper-sync"
LIMINE_MARKER = "### Auto-generated by limine-snapper-sync"
LIMINE_SECTION = "@@snapshots@@"
_LIMINE_HEADER = re.compile(r"^\s*(/+)\+?(.*?)\s*$")
_LIMINE_OPTION = re.compile(r"^\s*([A-Za-z_]+)\s*:\s?(.*)$")
_LIMINE_PATH_KEYS = {"path", "kernel_path", "module_path", "image_path", "dtb_path"}
_LIMINE_HISTORY = re.compile(r"^boot\(\):/[^/]+/limine_history/([^/#]+)_sha256_[0-9a-f]{64}(#[0-9a-f]+)$")
_SNAPSHOT_SUBVOL = re.compile(r"(subvol=)/?([^,\s]*?)/\.snapshots/(\d+)/snapshot(?=[,\s]|$)")


def _limine_split(text):
    """limine.conf as (outside, sections): the lines outside
    limine-snapper-sync's Snapshots sub-menus, with one placeholder line where
    each sub-menu stands, and the lines of each sub-menu. A sub-menu is an
    entry named Snapshots whose next line is the tool's marker comment; it
    runs to the next entry at the same or a higher level. Blank lines at its
    end count as outside."""
    lines = text.split("\n")
    outside, sections, cur, depth = [], [], None, 0

    def close():
        tail = []
        while cur and not cur[-1].strip():
            tail.insert(0, cur.pop())
        sections.append(cur)
        outside.extend(tail)

    for i, line in enumerate(lines):
        m = _LIMINE_HEADER.match(line)
        if cur is not None and m and len(m.group(1)) <= depth:
            close()
            cur = None
        if cur is None and m and m.group(2) == "Snapshots" and i + 1 < len(lines) \
                and lines[i + 1].strip() == LIMINE_MARKER:
            cur, depth = [line], len(m.group(1))
            outside.append(LIMINE_SECTION)
        elif cur is not None:
            cur.append(line)
        else:
            outside.append(line)
    if cur is not None:
        close()
    return outside, sections


def _snapshot_cmdline(cmdline, number):
    """A snapshot entry's command line with its snapshot subvolume put back
    to the live one it was copied from, or None when it names a snapshot
    other than `number` (any snapshot when `number` is None)."""
    def back(m):
        if number is not None and m.group(3) != number:
            raise ValueError
        return m.group(1) + m.group(2)
    try:
        return _SNAPSHOT_SUBVOL.sub(back, cmdline)
    except ValueError:
        return None


def _limine_known(text):
    """What a trusted limine.conf vouches for: its command lines (a snapshot
    entry's with the live subvolume put back), paths and protocols."""
    cmdlines, paths, protocols = set(), set(), set()
    for line in text.split("\n"):
        if _LIMINE_HEADER.match(line):
            continue
        m = _LIMINE_OPTION.match(line)
        if not m:
            continue
        key, value = m.group(1).lower(), m.group(2).strip()
        if key in ("cmdline", "kernel_cmdline"):
            cmdlines.add(_snapshot_cmdline(value, None))
        elif key in _LIMINE_PATH_KEYS:
            paths.add(value)
        elif key == "protocol":
            protocols.add(value)
    return cmdlines, paths, protocols


def _limine_section_ok(section, known):
    """True when every line of a Snapshots sub-menu is something
    limine-snapper-sync writes and the trusted copy vouches for: entries,
    comments, a protocol already in use, a command line the trusted copy
    already boots (with only the snapshot's own subvolume swapped in), and a
    boot file the trusted copy already names or its limine_history copy of a
    file the trusted copy boots, with the same hash."""
    cmdlines, paths, protocols = known
    depth = len(_LIMINE_HEADER.match(section[0]).group(1))
    number = None
    for line in section[1:]:
        if not line.strip() or line.strip().startswith("#"):
            continue
        h = _LIMINE_HEADER.match(line)
        if h:
            if len(h.group(1)) <= depth:
                return False
            if len(h.group(1)) == depth + 1:
                n = re.match(r"(\d+)\b", h.group(2))
                number = n.group(1) if n else None
            continue
        m = _LIMINE_OPTION.match(line)
        if not m:
            return False
        key, value = m.group(1).lower(), m.group(2).strip()
        if key == "comment":
            continue
        if key == "protocol":
            if value not in protocols:
                return False
        elif key in ("cmdline", "kernel_cmdline"):
            if number is None or _snapshot_cmdline(value, number) not in cmdlines:
                return False
        elif key in _LIMINE_PATH_KEYS:
            if value in paths:
                continue
            hist = _LIMINE_HISTORY.match(value)
            if not hist or not any(p.endswith("/" + hist.group(1) + hist.group(2)) for p in paths):
                return False
        else:
            return False
    return True


def limine_snapshot_only(text, reference):
    """True when limine.conf `text` differs from the trusted `reference` only
    inside limine-snapper-sync's Snapshots sub-menus, and those hold nothing
    the reference does not already vouch for. Everything else, the kernel
    command lines, kernel and initramfs paths, other entries, global options
    and where the sub-menus stand, must be byte-identical."""
    outside, sections = _limine_split(text)
    ref_outside, _ = _limine_split(reference)
    if outside != ref_outside:
        return False
    known = _limine_known(reference)
    return all(_limine_section_ok(s, known) for s in sections)


def _snapshots_json_ok(text, reference):
    """True when snapshots.json parses and every command line in it is one
    the trusted limine.conf already boots. The file is limine-snapper-sync's
    record of the sub-menu; the boot loader never reads it."""
    try:
        data = json.loads(text)
    except ValueError:
        return False
    cmdlines = _limine_known(reference)[0]
    found = []

    def walk(o):
        if isinstance(o, dict):
            for k, v in o.items():
                if k == "cmdline" and isinstance(v, str):
                    found.append(v)
                else:
                    walk(v)
        elif isinstance(o, list):
            for v in o:
                walk(v)
    walk(data)
    return isinstance(data, dict) and all(_snapshot_cmdline(c, None) in cmdlines for c in found)


def _limine_sync_wrote(path, since):
    """True when limine-snapper-sync's own program logged writing `path` (or,
    for a .old copy, the file it backs up) since `since`, within a few seconds
    of the file's modification time. The executable is recorded by journald,
    not by the program, so another program cannot log in its name."""
    target = path[:-4] if path.endswith(".old") else path
    want = f"{'Updated' if target == LIMINE_CONF else 'Saved'}: {target}"
    try:
        mtime = os.stat(path).st_mtime
        r = subprocess.run([_tool("journalctl"), "-q", "-o", "json", "--output-fields=MESSAGE",
                            f"--since=@{int(since)}", f"_EXE={LIMINE_SYNC_EXE}"],
                           capture_output=True, text=True, timeout=60)
    except (OSError, subprocess.SubprocessError):
        return False
    for line in r.stdout.splitlines():
        try:
            entry = json.loads(line)
            when = int(entry["__REALTIME_TIMESTAMP"]) / 1e6
        except (ValueError, KeyError, TypeError):
            continue
        # FAT keeps modification times to two seconds.
        if entry.get("MESSAGE") == want and abs(mtime - when) <= 5:
            return True
    return False


def limine_snapshot_change(path, reference_path, since):
    """True when a changed boot file is only limine-snapper-sync keeping its
    Snapshots sub-menu up to date: the file is one it manages, its program
    logged writing it since `since` (the last check), a trusted copy of
    limine.conf from the last accepted check exists, and the file passes the
    content check against that copy. spycatcher-scan calls this through
    --limine-snapshot-change and keeps that copy. Nothing checks this for a
    RED line after the fact: /boot and the copy are readable by root only,
    and both have moved on by the time the report runs."""
    managed = (path in (LIMINE_CONF, LIMINE_CONF + ".old")
               or re.fullmatch(r"/boot/[^/]+/limine_history/snapshots\.json(\.old)?", path))
    if not managed:
        return False
    try:
        reference = Path(reference_path).read_text()
        text = Path(path).read_text()
    except (OSError, UnicodeDecodeError):
        return False
    if not _limine_sync_wrote(path, since):
        return False
    if path.startswith(LIMINE_CONF):
        return limine_snapshot_only(text, reference)
    return _snapshots_json_ok(text, reference)


BOOT_NO_PACKAGE = "(boot file changed with no package update)"
_PACMAN_CHANGE = re.compile(r"^\[(\d{4}-\d\d-\d\dT\d\d:\d\d:\d\d[+-]\d{4})\] \[ALPM\] "
                            r"(?:upgraded|installed|removed|reinstalled|downgraded) ")


def _stamp(text):
    """An ISO time with its zone (pacman's +0100 or an AIDE log's +01:00) as
    an aware datetime, or None."""
    try:
        d = dt.datetime.fromisoformat(text)
    except ValueError:
        return None
    return d if d.tzinfo else None


def _logged(pattern, text):
    m = re.search(pattern, text, re.M)
    return _stamp(m.group(1)) if m else None


def pacman_changed(start, end, log=None):
    """True when pacman.log records a package installed, upgraded, removed,
    reinstalled or downgraded between `start` and `end`, both aware, so a
    change of clocks cannot reorder them."""
    if log is None:
        try:
            log = PACMAN_LOG.read_text(errors="replace")
        except OSError:
            return False
    for line in log.splitlines():
        m = _PACMAN_CHANGE.match(line)
        when = _stamp(m.group(1)) if m else None
        if when and start <= when <= end:
            return True
    return False


def boot_explained_by_pacman(when, path, runs, log=None):
    """True when the AIDE run logged at `when` (whose log is `path`) had a
    package transaction since the run before it. spycatcher-scan grades a boot
    change after one as a package change, but before 0.2.6 it missed
    reinstalls and downgrades, so this re-applies the rule to lines it logged
    red. It vouches only for the run the line came from; a later run says
    nothing about an earlier change.

    A run since 0.2.6 logs the window its count used. For an older one, the
    window runs from the end of the run before to the start of this one,
    which is never wider than what the scan saw: a transaction made while it
    ran may have come after AIDE read the file, so it does not count."""
    text = read(path)
    m = re.search(r"^pacman window: (\S+) to (\S+)$", text, re.M)
    if m:
        start, end = _stamp(m.group(1)), _stamp(m.group(2))
    else:
        earlier = [(w, p) for w, p in runs if w < when]
        if not earlier:
            return False
        prev = read(earlier[-1][1])
        start = (_logged(r"^=== done at (\S+) ===$", prev)
                 or _logged(r"^=== \S+ run at (\S+) ===$", prev))
        end = _logged(r"^=== \S+ run at (\S+) ===$", text)
    if start is None or end is None:
        return False
    return pacman_changed(start, end, log)


# spycatcher-scan logs "graded by spycatcher rules N" in each AIDE log, for
# the version of the rules it graded with: 2 in 0.2.12, 3 since 0.2.13 added
# dkms_built(), 4 since 0.3.0 added written_in_pacman_run(). Versions before
# 0.4.0 wrote "graded by security-scan rules N", under the project's earlier
# name, and those logs are still read.
RULES_VERSION = 4
RULES_LINE = re.compile(r"^graded by (?:spycatcher|security-scan) rules (\d+)$", re.M)


def recheck(line, links, log, when, until, current):
    """The grade a RED line earns now (PKG or AMBER), or None to keep it red.
    See unpackaged_explains() for the conditions."""
    path = line_path(line) or ""
    if until is None or not path.startswith("/") or not unchanged_since(path, until):
        return None
    if listed_link_explains(line, links):
        return PKG
    if not current and (hook_explains(line) or scriptlet_link_explains(line)):
        return PKG
    return unpackaged_explains(line, links, log, when, until, current)


# --- findings and acknowledgements ------------------------------------------
#
# The AIDE section reports findings, not log lines. A path logged by several
# runs is one finding, dated by the first run that logged it, and findings
# are grouped by the folder they are in and the day they were first seen, so
# one kernel update reads as one item. Each group has an ID that
# `sudo spycatcher-report --ack ID` records as checked. A red stays until it is
# acknowledged or a rule explains it; it does not age out of the window.

_LOGGED = re.compile(r"(\w+) (/.+) \(([^()]*)\)$")


def line_path(line):
    """The path of an AIDE verdict line without its grade, such as
    "added /usr/lib/x y (reason)". Paths may hold spaces; the reason is the
    last bracket."""
    m = _LOGGED.match(line)
    return m.group(2) if m else None


def file_state(path):
    """What `path` is now, for telling whether an acknowledged file has
    changed since: its type, and for a file its inode, size and change time,
    which no write leaves alone and which cannot be set back without moving
    the clock. Read with lstat. "unknown" when a folder on the way may not be
    searched by whoever runs the report."""
    try:
        st = os.lstat(path)
    except PermissionError:
        return "unknown"
    except OSError:
        return "absent"
    if stat.S_ISLNK(st.st_mode):
        try:
            return f"link:{os.readlink(path)}:{st.st_ctime_ns}"
        except OSError:
            return "unknown"
    if stat.S_ISDIR(st.st_mode):
        return f"folder:{st.st_mode:o}:{st.st_uid}:{st.st_gid}"
    kind = "file" if stat.S_ISREG(st.st_mode) else "other"
    return f"{kind}:{st.st_ino}:{st.st_size}:{st.st_ctime_ns}"


def load_acks(path=None):
    """The acknowledgements as a list of records, each {"id", "when",
    "reason", "by", "paths": {path: file_state}}. An unreadable or malformed
    file acknowledges nothing."""
    try:
        data = json.loads((path or ACKS).read_text())
    except (OSError, ValueError):
        return []
    acks = data.get("acks") if isinstance(data, dict) else None
    if not isinstance(acks, list):
        return []
    return [a for a in acks if isinstance(a, dict) and isinstance(a.get("paths"), dict)
            and _ack_when(a) is not None]


def _ack_when(a):
    try:
        return dt.datetime.fromisoformat(str(a.get("when"))).replace(tzinfo=None)
    except ValueError:
        return None


def acked_until(path, acks, states=None):
    """The time of the latest acknowledgement that still covers `path`, or
    None. It covers the path while the file is in the state it recorded; a
    file the report may not look at (state "unknown") is taken as unchanged,
    since only lines logged before the acknowledgement are covered and a
    later change is logged again. `states` caches file_state()."""
    best = None
    for a in acks:
        recorded = a["paths"].get(path)
        if not isinstance(recorded, str):
            continue
        if states is not None and path in states:
            now = states[path]
        else:
            now = file_state(path)
            if states is not None:
                states[path] = now
        if now == recorded or (now == "unknown" and recorded != "absent"):
            when = _ack_when(a)
            best = when if best is None or when > best else best
    return best


def group_id(kind, folder, day, paths):
    """A name for a group that also binds its members: a file that joins the
    group later gives it a new ID, so an acknowledgement covers only the
    files the report showed."""
    h = hashlib.sha256(f"aide\x1f{kind}\x1f{folder}\x1f{day}".encode())
    for path in sorted(paths):
        h.update(b"\x00" + path.encode(errors="surrogateescape"))
    return h.hexdigest()[:8]


REMOVED_UNLISTED = "unpackaged file removed"


def finding_groups(kind, found):
    """[(id, folder, first seen, [(when, path, line)])] for findings
    {path: (when, line)}, grouped by the folder each is in, cut to its first
    three levels, the largest group first. Reds are grouped by the day first
    seen as well, which tells one event from another; ambers leave the
    window after a week, so one folder is one item."""
    groups = {}
    for path, (when, line) in found.items():
        # Files removed that no package listed are one event a day: an
        # upgrade removes them from hundreds of folders at once, and a
        # removal adds no code.
        if line.endswith(f"({REMOVED_UNLISTED})"):
            folder = REMOVED_UNLISTED
        else:
            folder = "/".join(os.path.dirname(path).split("/")[:4]) or "/"
        day = when.date() if kind == RED or folder == REMOVED_UNLISTED else None
        groups.setdefault((folder, day), []).append((when, path, line))
    out = []
    for (folder, day), entries in groups.items():
        entries.sort()
        gid = group_id(kind, folder, day.isoformat() if day else "", [e[1] for e in entries])
        out.append((gid, folder, entries[0][0], entries))
    out.sort(key=lambda g: (-len(g[3]), g[1]))
    return out


# Folders where a change can give someone root or code that runs at boot or
# login. `--ack amber` leaves out any item with a file in one of these, so
# each needs its own ID.
SENSITIVE = ("/etc/sudoers", "/etc/pam.d", "/etc/security", "/etc/systemd", "/usr/lib/systemd",
             "/etc/pacman", "/etc/polkit-1", "/usr/share/polkit-1", "/etc/modprobe.d",
             "/etc/modules-load.d", "/etc/profile", "/etc/environment", "/etc/ld.so",
             "/etc/ssh", "/etc/udev", "/etc/cron", "/etc/xdg/autostart", "/etc/passwd",
             "/etc/shadow", "/etc/group", "/etc/gshadow", "/etc/hosts", "/etc/nsswitch.conf",
             "/etc/shells", "/etc/mkinitcpio", "/etc/default", "/etc/kernel", "/root",
             "/usr/local/bin", "/usr/local/sbin", "/usr/local/lib", "/boot", "/etc/spycatcher")


def sensitive(path):
    return path.startswith(SENSITIVE)


# Every AIDE group the last integrity() call reported, {id: [path]}, for
# --ack, and the logs that hold an open red, for --keep-logs.
FOUND_GROUPS = {}
AMBER_GROUPS = set()
OPEN_RED_LOGS = set()


def ack_hint(gid):
    return f'Once checked, clear it with: sudo spycatcher-report --ack {gid} --reason "what it was"'


def integrity(now, since):
    s = Section("System file integrity (AIDE)", GREEN, "")
    recent, _ = logs("aide", since)
    if not recent:
        s.rating, s.headline = AMBER, "No AIDE result yet."
        return s
    # Every time each path was logged, as (when, line, log), by grade.
    reds, ambers, pkg = {}, {}, 0
    links = listed_links()
    runs, _ = logs("aide", dt.datetime.min)
    in_window = {p for _, p in recent}
    pacman_log = None
    old_kernels = {}
    FOUND_GROUPS.clear()
    AMBER_GROUPS.clear()
    OPEN_RED_LOGS.clear()

    def seen(found, when, line, p):
        path = line_path(line)
        if path:
            found.setdefault(path, []).append((when, line, p))
    # One pacman call for the owners of every red file in logs from before
    # these rules, which are the ones re-checked below.
    prefetch_owners([line_path(l[4:]) or "" for t in (read(p) for _, p in runs)
                     if not (RULES_LINE.search(t) and int(RULES_LINE.search(t).group(1)) >= RULES_VERSION)
                     for l in t.splitlines() if l.startswith("RED ")])
    # Reds are read from every log kept, so one does not age out unseen;
    # ambers and the package count from the window only.
    for when, p in runs:
        text = read(p)
        recent_run = p in in_window
        # A run that logged the rules version it graded with already applied
        # every rule below; only scan.conf's lists, which the administrator
        # may have added to since, are applied to its red lines again. A
        # file is re-checked only if it has not changed since the run ended.
        m = RULES_LINE.search(text)
        current = bool(m) and int(m.group(1)) >= RULES_VERSION
        # A file written after the run started may not be what AIDE read,
        # so a re-check only looks at files unchanged since the start.
        until = when
        for line in text.splitlines():
            if line.startswith("RED ") and line.endswith(BOOT_NO_PACKAGE):
                if pacman_log is None:
                    try:
                        pacman_log = PACMAN_LOG.read_text(errors="replace")
                    except OSError:
                        pacman_log = ""
                if boot_explained_by_pacman(when, p, runs, pacman_log):
                    pkg += recent_run
                    continue
            # A red limine.conf or snapshots.json line is not re-read with
            # limine_snapshot_change: the report cannot read /boot or the
            # trusted copy, and neither is what it was when the line was logged.
            if line.startswith("RED "):
                grade = recheck(line[4:], links, pacman_log, when, until, current)
                if grade == PKG:
                    pkg += recent_run
                elif grade == MAYBE:
                    if recent_run:
                        seen(ambers, when, line[4:], p)
                else:
                    seen(reds, when, line[4:], p)
            elif not recent_run:
                continue
            elif line.startswith("AMBER "):
                # Modules of a kernel that is gone, logged one by one before
                # the scan summarised them.
                m = re.match(r"AMBER removed /usr/lib/modules/([^/ ]+)(?:/| \()", line)
                if m and m.group(1) not in old_kernels:
                    old_kernels[m.group(1)] = old_kernel_modules(m.group(1))
                if m and old_kernels[m.group(1)]:
                    pkg += 1
                    continue
                seen(ambers, when, line[6:], p)
            elif line.startswith("PKG "):
                # The scan logs a removed kernel's modules as one line that
                # counts them.
                m = re.match(r"PKG removed /usr/lib/modules/\S+ \((\d+) entries, ", line)
                pkg += int(m.group(1)) if m else 1
    # An acknowledgement covers the lines logged before it while the file is
    # as it recorded. A line logged after it is a new finding, dated by the
    # first such line.
    acks = load_acks()
    states = {}

    def still_open(found):
        out = {}
        for path, times in found.items():
            until = acked_until(path, acks, states)
            later = sorted(t for t in times if until is None or t[0] > until)
            if later:
                out[path] = later
        return out
    open_reds = still_open(reds)
    open_ambers = {k: v for k, v in still_open(ambers).items() if k not in open_reds}
    for times in open_reds.values():
        OPEN_RED_LOGS.update(p for _, _, p in times)
    red_groups = finding_groups(RED, {k: v[0][:2] for k, v in open_reds.items()})
    for gid, folder, first, entries in red_groups:
        FOUND_GROUPS[gid] = [path for _, path, _ in entries]
        if len(entries) == 1:
            what = entries[0][2]
        else:
            folders = len({os.path.dirname(path) for _, path, _ in entries})
            what = f"{len(entries)} unexplained changes in {folders} folder(s) under {folder}"
        s.add(RED, what,
              f"Item {gid}, first seen {first:%a %d %b}."
              + (f" For example: {entries[0][2]}" if len(entries) > 1 else ""),
              "A system file changed outside any package update. Compare with pacman -Qkk, "
              "and if it cannot be explained treat the machine as compromised. " + ack_hint(gid))
    # Amber changes are mostly your own edits or an update doing something no
    # rule knows; grouped by folder, a week of work reads as a few lines.
    amber_groups = finding_groups(AMBER, {k: v[0][:2] for k, v in open_ambers.items()})
    for gid, folder, first, entries in amber_groups:
        FOUND_GROUPS[gid] = [path for _, path, _ in entries]
        if not any(sensitive(path) for _, path, _ in entries):
            AMBER_GROUPS.add(gid)
        example = (entries[0][2] if len(entries) == 1
                   else f"{len(entries)} files, e.g. {entries[0][2]}")
        s.add(AMBER, (f"{len(entries)} file(s) removed that no package listed at the last check"
                      if folder == REMOVED_UNLISTED else f"Changed outside a package: {folder}"),
              f"Item {gid}, first seen {first:%a %d %b}. {example}",
              "Confirm these were your own changes (installs, config edits) or a package "
              "update. " + ack_hint(gid))
    # Every acknowledgement is listed, so one you did not make shows.
    for a in sorted(acks, key=_ack_when):
        s.add(GREEN, f"Acknowledged {a.get('id', '?')}: {a.get('reason', '')}",
              f"{len(a['paths'])} file(s), {_ack_when(a):%a %d %b %H:%M} by {a.get('by', '?')}")
    on_record = f" {len(acks)} acknowledgement(s) on record." if acks else ""
    runs_n = len(recent)
    if red_groups:
        s.headline = (f"{len(red_groups)} item(s) of unexplained changes to system files "
                      f"({len(open_reds)} file(s)).{on_record}")
    elif amber_groups:
        s.headline = (f"{runs_n} check(s) ran. No unexplained changes. {len(amber_groups)} "
                      f"item(s) to confirm ({len(open_ambers)} file(s)); {pkg} came from package "
                      f"updates.{on_record}")
    else:
        s.headline = (f"{runs_n} check(s) ran. Nothing changed except through package updates "
                      f"({pkg} files).{on_record}")
    return s

def rootkit(now, since):
    s = Section("Rootkit check (rkhunter)", GREEN, "")
    recent, _ = logs("rkhunter", since)
    if not recent:
        s.rating, s.headline = AMBER, "No rkhunter result yet."
        return s
    # Grade the latest run only. rkhunter checks the whole system each time,
    # so a clean run supersedes the warnings of the runs before it; counting
    # the week's runs would keep a cleared warning red for up to seven days.
    when, p = recent[-1]
    text = read(p)
    # Only the scan's own summary line, never text rkhunter printed.
    m = re.match(r"(\d+) warning", summary(text) or "")
    warned = int(m.group(1)) if m else 0
    if warned:
        # A "properties changed" warning whose files pacman verified was
        # accepted by the scanner; only its UNVERIFIED files still count.
        found = [w for w in re.findall(r"^(?:\| )?Warning: (.*)$", text, re.M)
                 if "file properties have changed" not in w]
        found += [f"File changed and pacman cannot vouch for it: {f}"
                  for f in re.findall(r"^UNVERIFIED (.*)$", text, re.M)]
        for w in found:
            s.add(RED, w, when.strftime("%a %d %b"),
                  "Investigate before anything else. If it is a new false positive, "
                  "verify with pacman -Qkk and add it to /etc/rkhunter.conf.local.")
    earlier = sum(1 for _, q in recent[:-1]
                  if re.match(r"[1-9]\d* warning", summary(read(q)) or ""))
    cleared = (f" {earlier} earlier run(s) this period had warnings that this run no longer shows."
               if earlier and not warned else "")
    s.headline = (f"{warned} warning(s) in the latest check." if warned
                  else f"The latest check found no warnings.{cleared}")
    return s


def models(now, since):
    s = Section("AI model files", GREEN, "")
    recent, latest = logs("models", since)
    if not recent:
        s.rating, s.headline = AMBER, "No model scan yet."
        return s
    dangerous = suspicious = 0
    for when, p in recent:
        text = read(p)
        # Tool output is logged with "| " in front since 0.2.12; the finding
        # is shown without it.
        for line in re.findall(r"^(?:\| )?(.*(?:dangerous|suspicious) import.*)$", text, re.M):
            bad = "dangerous" in line
            dangerous += bad
            suspicious += not bad
            s.add(RED if bad else AMBER, line, when.strftime("%a %d %b"),
                  "Do not load this file. Delete it and get the model as .safetensors instead."
                  if bad else "Check where the file came from before loading it.")
    last = summary(read(latest[1])) or ""
    m = re.search(r"(\d+) pickle-format", last)
    pickles = int(m.group(1)) if m else 0
    if not dangerous and not suspicious:
        s.headline = (f"{len(recent)} scan(s), nothing malicious. {pickles} model file(s) use the "
                      "older pickle format; all scanned clean.")
        if pickles:
            s.add(GREEN, f"{pickles} pickle-format file(s) present, scanned clean",
                  "Pickle files can run code when loaded; safetensors and GGUF cannot.",
                  "Prefer .safetensors when downloading models.")
    else:
        s.headline = f"{dangerous} dangerous and {suspicious} suspicious model file(s)."
    return s


def secrets(now, since, reg):
    s = Section("Secrets in your code (gitleaks)", GREEN, "")
    _, latest = logs("gitleaks", since)
    if not latest:
        s.rating, s.headline = AMBER, "No gitleaks result yet."
        return s
    text = read(latest[1])
    known = reg.get("secrets", {})
    total = 0
    # The scan logs each repository as "--- PATH: N finding(s) ---". A path
    # may hold spaces or colons, so it runs to the last ": N finding(s) ---"
    # on the line rather than stopping at the first space.
    for m in re.finditer(r"^--- (/.*): (\d+) finding\(s\) ---$", text, re.M):
        repo, n = m.group(1), m.group(2)
        total += int(n)
        block = text[m.end():].split("\n--- ", 1)[0]
        rules = set(re.findall(r'"RuleID": "([^"]+)"', block))
        entry = next((e for e in known.values()
                      if e.get("repo") == repo and e.get("rule") in rules), None)
        name = Path(repo).name
        if entry:
            s.add(entry.get("rating", AMBER), f"{name}: {entry.get('risk', '')}",
                  entry.get("finding", ""), entry.get("action", ""))
        else:
            s.add(RED, f"{name}: {n} possible secret(s) ({', '.join(sorted(rules))})",
                  f"From the scan on {latest[0]:%a %d %b}.",
                  "Check the log. Rotate any real key or password, then remove it from the repo.")
    # The scan's own count is the check on the lines above: findings it
    # counted that no repository line accounts for must not read as green.
    logged = summary(text) or ""
    m = re.match(r"(\d+) finding", logged)
    if m and int(m.group(1)) > total:
        missing = int(m.group(1)) - total
        s.add(RED, f"{missing} possible secret(s) the report could not match to a repository",
              f"From the scan on {latest[0]:%a %d %b}.",
              "Check the log. Rotate any real key or password, then remove it from the repo.")
        total = int(m.group(1))
    s.headline = ("No secrets found in the scanned repositories." if not total
                  else f"{total} finding(s); see below for what each one is.")
    return s


def hardening(now, since):
    s = Section("System hardening (lynis, monthly)", GREEN, "")
    _, latest = logs("lynis", dt.datetime.min)
    if not latest:
        s.rating, s.headline = AMBER, "No lynis audit yet."
        return s
    text = read(latest[1])
    m = re.match(r"hardening index (\d+)", summary(text) or "")
    index = int(m.group(1)) if m else None
    warns = re.findall(r"^(?:\| )?warning\[\]=([^|]+)\|([^|]+)", text, re.M)
    for wid, msg in warns:
        # lynis flags any arch-audit output, which the package section
        # already grades properly.
        if wid == "PKGS-7322":
            s.add(GREEN, f"{msg} ({wid})", "", "Covered by the package section above.")
        else:
            s.add(AMBER, f"{msg} ({wid})", "", f"Run: sudo lynis show details {wid}")
    s.headline = (f"Hardening score {index}/100 on {latest[0]:%d %b}. "
                  "A score in the high 60s is typical for a desktop; the suggestions are mostly "
                  "server hardening.") if index is not None else "No score recorded."
    return s


def standing(reg):
    s = Section("Standing risks", GREEN, "")
    checks = {
        "ufw_active": lambda: run(["systemctl", "is-active", "ufw"]).strip() == "active",
        # The device holding / must itself be a LUKS mapping, not merely some
        # disk on the machine.
        "root_luks": lambda: "crypt" in run(["lsblk", "-no", "TYPE",
                                              run(["findmnt", "-no", "SOURCE", "/"]).strip().split("[")[0]]).split(),
    }
    for key, e in reg.get("standing", {}).items():
        test = checks.get(e.get("check"))
        holds = test() if test else True
        r = e.get("rating", AMBER)
        if not holds:
            r = RED
            s.add(r, e.get("risk", key), "This protection is no longer in place.",
                  "Check why, then update the register.")
        else:
            s.add(r, e.get("risk", key), e.get("finding", ""), e.get("action", ""))
    s.headline = "Design choices and protections checked live."
    return s


# --- privacy (Black Ops) -----------------------------------------------------

# Black Ops writes the summary each time its watchdog runs, which is far more
# often than weekly. A summary older than this means the watchdog stopped, and
# the counts in it can no longer be trusted as current.
PRIVACY_STALE_DAYS = 8
SUMMARY_REL = Path(".local/state/black-ops/summary.json")


def summary_location(environ=None, euid=None, getpwnam=pwd.getpwnam, getpwuid=pwd.getpwuid):
    """Where to find the Black Ops summary, and a note on how it was chosen.

    Returns (path or None, note). The note is shown in the report and never
    names the account, because the HTML report is written to disk.
    """
    environ = os.environ if environ is None else environ
    euid = os.geteuid() if euid is None else euid
    if environ.get("BLACK_OPS_SUMMARY"):
        return Path(environ["BLACK_OPS_SUMMARY"]), "Read from the path in BLACK_OPS_SUMMARY."
    if euid == 0:
        # Run through sudo: the summary that matters is the invoking user's,
        # not root's. The environment under sudo belongs to root, so the
        # home folder comes from the password database.
        who = environ.get("SUDO_USER", "")
        if who and who != "root":
            try:
                return (Path(getpwnam(who).pw_dir) / SUMMARY_REL,
                        "Run as root through sudo, so the invoking user's summary was read.")
            except KeyError:
                pass
        return None, ("Run as root with no invoking user, so no summary was read. "
                      "Black Ops keeps its summary per user; run the report as that user.")
    state = environ.get("XDG_STATE_HOME", "")
    if state and os.path.isabs(state):
        return Path(state) / "black-ops/summary.json", ""
    try:
        home = Path(getpwuid(euid).pw_dir)
    except KeyError:
        home = Path(environ.get("HOME", "~")).expanduser()
    return home / SUMMARY_REL, ""


def _count(obj, *keys):
    """A non-negative integer from nested keys, or 0 when absent or not a count."""
    for k in keys:
        obj = obj.get(k) if isinstance(obj, dict) else None
    return obj if isinstance(obj, int) and not isinstance(obj, bool) and obj > 0 else 0


def _flag(obj, *keys):
    for k in keys:
        obj = obj.get(k) if isinstance(obj, dict) else None
    return obj is True


def privacy(now, reg, location=None):
    s = Section("Privacy (Black Ops)", GREEN, "")
    path, note = location if location is not None else summary_location()
    accepted = reg.get("privacy", {}) if isinstance(reg.get("privacy"), dict) else {}

    def add(key, rating, what, detail="", action="", count=None):
        # A register entry may lower the rating of one item, for example to
        # accept unreviewed watch findings while they are looked into. A
        # confirmed leak cannot be accepted here: review it in Black Ops,
        # which is what clears its red. With `count` set, the entry holds only
        # while the count stays at or below it, so a new finding is not hidden.
        e = accepted.get(key)
        if (isinstance(e, dict) and key != "listen-leak"
                and e.get("rating") in ORDER and ORDER[e["rating"]] < ORDER[rating]
                and (count is None or not isinstance(e.get("count"), int) or count <= e["count"])):
            rating = e["rating"]
            detail = " ".join(x for x in (detail, e.get("finding", "")) if x)
            action = e.get("action", action)
        s.add(rating, what, detail, action)

    if path is None:
        s.rating, s.headline = GREY, "Not checked. " + note
        return s
    rel = "~/.local/state/black-ops/summary.json"
    try:
        raw = path.read_text()
    except FileNotFoundError:
        s.rating = GREY
        s.headline = "Black Ops is not installed, or is older than 0.3.0. Nothing here was checked."
        s.add(GREY, f"No Black Ops summary at {rel}", note,
              "Nothing to do unless you use Black Ops. If you do, open its panel once so it writes the summary.")
        return s
    except OSError as err:
        add("unreadable", AMBER, "The Black Ops summary exists but cannot be read",
            f"{err.strerror}. {note}".strip(), "Check the file's owner and permissions.")
        s.headline = "The summary could not be read, so privacy is not being checked."
        return s
    try:
        data = json.loads(raw)
        if not isinstance(data, dict):
            raise ValueError("not a JSON object")
    except ValueError:
        add("unreadable", AMBER, "The Black Ops summary is not valid JSON", note,
            "Open the Black Ops panel so it rewrites the file. If this keeps happening, report it to Black Ops.")
        s.headline = "The summary could not be read, so privacy is not being checked."
        return s
    if data.get("schema") != 1:
        add("unreadable", AMBER, "The Black Ops summary is in a format this report does not know",
            "It was probably written by a newer Black Ops.", "Update Spycatcher.")
        s.headline = "The summary could not be read, so privacy is not being checked."
        return s

    if data.get("master") is not True or data.get("overall") == "off":
        s.rating = GREY
        s.headline = "Black Ops is switched off. Nothing here was checked, and that is not counted as a problem."
        s.add(GREY, "Black Ops is off", note, "Switch it on in its panel if you want privacy checked.")
        return s

    stale = False
    when = data.get("generatedAt")
    if isinstance(when, (int, float)) and not isinstance(when, bool) and when > 0:
        written = dt.datetime.fromtimestamp(when)
        age = max(now - written, dt.timedelta(0))
        if age.days >= PRIVACY_STALE_DAYS:
            stale = True
            add("stale", AMBER, f"The Black Ops summary was last written {ago(written, now)}",
                "Black Ops refreshes it every time its watchdog runs, so the watchdog has stopped. "
                "The counts below are from then.",
                "Open the Black Ops panel, and check that its watchdog is running.")
    else:
        stale = True
        add("stale", AMBER, "The Black Ops summary does not say when it was written", "",
            "Open the Black Ops panel so it rewrites the file.")

    leaks = _count(data, "listen", "leaks")
    if _flag(data, "listen", "enabled"):
        if leaks:
            add("listen-leak", RED, f"Listen mode saw {leaks} contact(s) with a telemetry host, not yet reviewed",
                "A program on this machine sent data to a known telemetry, analytics or crash-report service.",
                "Open Black Ops to see which program it was. Remove or block it, or review it there if it is expected.")
        else:
            unknown = _count(data, "listen", "unknownHosts")
            add("listen-clean", GREEN, "Listen mode is on and saw no telemetry contacts",
                f"{unknown} host(s) matched no known signature; that is information only." if unknown else "")
    else:
        add("listen-off", GREY, "Listen mode is off, so contacts with telemetry hosts are not being watched", "",
            "Nothing to do. Switch it on in Black Ops if you want contacts watched.")
    if leaks == 0 and data.get("overall") == "leak":
        add("listen-leak", RED, "Black Ops reports a leak", "",
            "Open Black Ops to see which program it was, and remove, block or review it.")

    if _flag(data, "watch", "enabled"):
        unrev = _count(data, "watch", "unreviewed")
        flagged = _count(data, "watch", "flagged")
        if unrev:
            add("watch-unreviewed", AMBER, f"The software watch has {unrev} finding(s) not yet reviewed",
                "Installed software contains the address of a known tracking service.",
                "Open Black Ops and mark each one Allow or False positive.", count=unrev)
        else:
            add("watch-clean", GREEN, "The software watch has nothing waiting for review",
                f"{flagged} finding(s) already reviewed." if flagged else "")
        last = data["watch"].get("lastScan")
        if not (isinstance(last, (int, float)) and not isinstance(last, bool) and last > 0):
            add("watch-noscan", AMBER, "The software watch has not finished a scan yet", "",
                "The first scan runs within a day of switching it on. If it is older than that, check it in Black Ops.")
        elif (now - dt.datetime.fromtimestamp(last)).days >= PRIVACY_STALE_DAYS:
            add("watch-noscan", AMBER,
                f"The software watch last finished a scan {ago(dt.datetime.fromtimestamp(last), now)}", "",
                "Check it in Black Ops; its timers may have stopped.")
    else:
        add("watch-off", GREY, "The software watch is off, so installed software is not checked for tracking", "",
            "Nothing to do. Switch it on in Black Ops if you want software checked.")

    holding = _count(data, "protections", "holding")
    for key, n, what, action in (
        ("slipped", _count(data, "protections", "slipped"),
         "protection(s) were in place and have slipped",
         "Open Black Ops to see which, and switch each one on again. An update may have undone it."),
        ("unapplied", _count(data, "protections", "unapplied"),
         "protection(s) are switched on but not yet in place",
         "Open Black Ops and apply them."),
        ("attention", _count(data, "protections", "attention"),
         "protection(s) are in place but need a look",
         "Open Black Ops; each one says what it needs."),
        ("registered", _count(data, "registered", "notHolding"),
         "protection(s) registered by other plugins are not holding",
         "Open Black Ops to see which, and fix them in the plugin that registered them."),
    ):
        if n:
            add(key, AMBER, f"{n} {what}", "", action, count=n)
    reg_holding = _count(data, "registered", "holding")
    off = _count(data, "protections", "off")
    detail = f"{off} more are switched off by choice." if off else ""
    add("holding", GREEN, f"{holding + reg_holding} protection(s) holding", detail)

    # Black Ops says "warn" for the counts above, which the register may have
    # accepted. Only a warning that none of them explains is added here.
    explained = any(_count(data, *k) for k in (
        ("watch", "unreviewed"), ("protections", "slipped"), ("protections", "unapplied"),
        ("protections", "attention"), ("registered", "notHolding")))
    if not explained and data.get("overall") == "warn":
        add("warn", AMBER, "Black Ops reports something needs attention", "",
            "Open Black Ops; the rows that need a look are amber.")

    reds = sum(1 for r, *_ in s.items if r == RED)
    ambers = sum(1 for r, *_ in s.items if r == AMBER)
    parts = []
    if reds:
        parts.append("Listen mode saw a program on this machine contact a telemetry service.")
    if ambers:
        parts.append(f"{ambers} item(s) need a look.")
    if not reds and not ambers:
        parts.append("Black Ops is on and nothing needs a look.")
    if stale:
        parts.append("The counts are out of date.")
    offs = [n for k, n in (("listen", "listen mode"), ("watch", "the software watch"))
            if not _flag(data, k, "enabled")]
    if offs:
        parts.append(f"{' and '.join(offs).capitalize()} {'is' if len(offs) == 1 else 'are'} off.")
    if not stale and isinstance(when, (int, float)) and now - dt.datetime.fromtimestamp(when) >= dt.timedelta(hours=1):
        parts.append(f"Last written {ago(dt.datetime.fromtimestamp(when), now)}.")
    if note:
        parts.append(note)
    s.headline = " ".join(parts)
    return s


# --- helpers -----------------------------------------------------------------

# Where the weekly timer and the bar widget keep their pages.
REPORT_DIR = Path.home() / ".local/share/spycatcher"


def _make_private(path, want_dir):
    """Take group and other permissions off `path` when it is a folder (or,
    with want_dir False, a regular file) of the current user's and not a
    symlink. It is opened without following a link and changed through that
    handle, so nothing can swap a link in between the check and the change."""
    flags = os.O_RDONLY | os.O_NOFOLLOW | (os.O_DIRECTORY if want_dir else 0)
    try:
        fd = os.open(path, flags)
    except OSError:
        return
    try:
        st = os.fstat(fd)
        kind = stat.S_ISDIR if want_dir else stat.S_ISREG
        if kind(st.st_mode) and st.st_uid == os.getuid() and st.st_mode & 0o077:
            os.fchmod(fd, stat.S_IMODE(st.st_mode) & 0o700)
    finally:
        os.close(fd)


def write_private(path, text):
    """Write an HTML report that only its owner can read. It names
    repositories, rules and changed files, so the page is 0600 and a folder
    this makes is 0700. The report folder, and the pages already in it from
    earlier versions, which wrote them with the user's umask, are made
    private too. A folder given on the command line that already existed is
    the user's choice and is left as it is. The page is written to a new file
    and renamed over the old one, so it never passes through a readable
    state, and a symlink at the path is replaced rather than written
    through."""
    path = Path(os.path.abspath(path))
    os.umask(0o077)
    path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    if path.parent == Path(os.path.abspath(REPORT_DIR)):
        _make_private(path.parent, True)
        for old in path.parent.glob("*.html"):
            _make_private(old, False)
    tmp = path.with_name(f".{path.name}.{os.getpid()}.tmp")
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
    try:
        with os.fdopen(fd, "w") as f:
            f.write(text)
        os.replace(tmp, path)
    except BaseException:
        with contextlib.suppress(OSError):
            os.unlink(tmp)
        raise


def run(cmd):
    """A program's output, run by its full path in SAFE_ENV, or "" when it
    fails."""
    cmd = [cmd[0] if cmd[0].startswith("/") else _tool(cmd[0]), *cmd[1:]]
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=20,
                              env=SAFE_ENV).stdout
    except (OSError, subprocess.SubprocessError):
        return ""


def vercmp(a, b):
    out = run(["vercmp", a, b]).strip()
    try:
        return int(out)
    except ValueError:
        return 0


def installed_versions():
    out = {}
    for line in run(["pacman", "-Q"]).splitlines():
        parts = line.split()
        if len(parts) == 2:
            out[parts[0]] = parts[1]
    return out


# --- output ------------------------------------------------------------------

LABEL = {GREY: "GREY", GREEN: "GREEN", AMBER: "AMBER", RED: "RED"}
DOT = {GREY: "○", GREEN: "●", AMBER: "▲", RED: "■"}
ANSI = {GREY: "\033[90m", GREEN: "\033[32m", AMBER: "\033[33m", RED: "\033[31m"}


def overall_line(overall, sections):
    reds = sum(1 for s in sections for r, *_ in s.items if r == RED)
    ambers = sum(1 for s in sections for r, *_ in s.items if r == AMBER)
    if overall == GREEN:
        return "Nothing needs your attention."
    if overall == RED:
        return f"{reds} item(s) need action now; {ambers} are being managed."
    return f"Nothing urgent. {ambers} item(s) are open and being managed."


def text_report(sections, overall, start, end, colour, show_all=False):
    def c(r, t):
        return f"{ANSI[r]}{t}\033[0m" if colour else t
    bold = (lambda t: f"\033[1m{t}\033[0m") if colour else (lambda t: t)
    out = [bold(f"Spycatcher report, {start:%a %d %b} to {end:%a %d %b %Y}"),
           f"Overall: {c(overall, DOT[overall] + ' ' + LABEL[overall])}. {overall_line(overall, sections)}", ""]
    for s in sections:
        out.append(f"{c(s.rating, DOT[s.rating] + ' ' + LABEL[s.rating]):<8}  {bold(plain(s.title))}")
        out.append(f"          {plain(s.headline)}")
        hidden = 0
        for r, what, detail, action in sorted(s.items, key=lambda i: -ORDER[i[0]]):
            # In a section that needs attention, green lines are noise unless
            # asked for; they are counted instead.
            if r == GREEN and s.rating not in (GREEN, GREY) and not show_all:
                hidden += 1
                continue
            out.append(f"          {c(r, DOT[r])} {what}")
            if detail:
                out.append(f"              {detail}")
            if action and r != GREEN:
                out.append(f"              What is being done: {action}")
        if hidden:
            out.append(f"          {c(GREEN, DOT[GREEN])} {hidden} more item(s) are green (--all lists them)")
        out.append("")
    return "\n".join(out)


def html_report(sections, overall, start, end):
    e = html.escape
    rows = []
    for s in sections:
        items = []
        for r, what, detail, action in sorted(s.items, key=lambda i: -ORDER[i[0]]):
            items.append(
                f'<li class="{r}"><span class="pill {r}">{LABEL[r]}</span>'
                f'<div><div class="what">{e(what)}</div>'
                + (f'<div class="detail">{e(detail)}</div>' if detail else "")
                + (f'<div class="action"><b>What is being done:</b> {e(action)}</div>' if action else "")
                + "</div></li>")
        rows.append(
            f'<details class="card {s.rating}" {"open" if s.rating not in (GREEN, GREY) else ""}>'
            f'<summary><span class="pill {s.rating}">{LABEL[s.rating]}</span>'
            f'<span class="title">{e(plain(s.title))}</span></summary>'
            f'<p class="headline">{e(plain(s.headline))}</p><ul>{"".join(items)}</ul></details>')
    return f"""<!doctype html>
<html lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Spycatcher report</title>
<style>
:root {{ --bg:#f6f6f4; --card:#fff; --ink:#1d1d1b; --muted:#5f5f5a; --line:#e2e2dd;
  --green:#1f7a3f; --green-bg:#e3f3e8; --amber:#8a5a00; --amber-bg:#fdf0d5;
  --red:#b3261e; --red-bg:#fbe3e1; --grey:#5f5f5a; --grey-bg:#ecece8; }}
@media (prefers-color-scheme: dark) {{ :root {{ --bg:#141413; --card:#1f1f1d; --ink:#ecece8;
  --muted:#a3a39c; --line:#33332f; --green:#6fd08c; --green-bg:#16301f; --amber:#f2c14e;
  --amber-bg:#3a2d10; --red:#ff8a80; --red-bg:#3d1916; --grey:#a3a39c; --grey-bg:#2a2a27; }} }}
body {{ margin:0; background:var(--bg); color:var(--ink);
  font:15px/1.5 system-ui, -apple-system, "Segoe UI", sans-serif; }}
main {{ max-width:860px; margin:0 auto; padding:24px 16px 48px; }}
h1 {{ font-size:22px; margin:0 0 4px; }}
.sub {{ color:var(--muted); margin:0 0 20px; }}
.overall {{ display:flex; gap:12px; align-items:center; padding:16px; border-radius:10px;
  background:var(--card); border:1px solid var(--line); margin-bottom:20px; }}
.overall .pill {{ font-size:15px; padding:6px 14px; }}
.card {{ background:var(--card); border:1px solid var(--line); border-left:6px solid var(--line);
  border-radius:10px; margin:0 0 12px; padding:12px 16px; }}
.card.green {{ border-left-color:var(--green); }} .card.amber {{ border-left-color:var(--amber); }}
.card.red {{ border-left-color:var(--red); }} .card.grey {{ border-left-color:var(--grey); }}
summary {{ cursor:pointer; display:flex; gap:10px; align-items:center; list-style:none; }}
summary::-webkit-details-marker {{ display:none; }}
.title {{ font-weight:600; }}
.headline {{ margin:8px 0; }}
ul {{ list-style:none; padding:0; margin:0; }}
li {{ display:flex; gap:10px; padding:10px 0; border-top:1px solid var(--line); }}
.pill {{ flex:none; font-size:11px; font-weight:700; letter-spacing:.04em; padding:2px 8px;
  border-radius:999px; height:fit-content; }}
.pill.green {{ color:var(--green); background:var(--green-bg); }}
.pill.amber {{ color:var(--amber); background:var(--amber-bg); }}
.pill.red {{ color:var(--red); background:var(--red-bg); }}
.pill.grey {{ color:var(--grey); background:var(--grey-bg); }}
.what {{ font-weight:500; overflow-wrap:anywhere; }}
.detail {{ color:var(--muted); overflow-wrap:anywhere; }}
.action {{ margin-top:4px; }}
</style></head><body><main>
<h1>Spycatcher report</h1>
<p class="sub">{start:%a %d %b} to {end:%a %d %b %Y}, generated {end:%H:%M}</p>
<div class="overall"><span class="pill {overall}">{LABEL[overall]}</span>
<span>{e(overall_line(overall, sections))}</span></div>
{"".join(rows)}
</main></body></html>
"""


def write_acks(acks):
    """Writes the acknowledgements as root, readable by the group the risk
    register is shared with, through a new file moved into place."""
    try:
        gid = os.stat(REGISTER).st_gid
    except OSError:
        gid = 0
    tmp = ACKS.with_name(ACKS.name + ".new")
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW, 0o600)
    with os.fdopen(fd, "w") as f:
        json.dump({"version": 1, "acks": acks}, f, indent=1, sort_keys=True)
        f.write("\n")
    os.chown(tmp, 0, gid)
    os.chmod(tmp, 0o640 if gid else 0o600)
    os.replace(tmp, ACKS)


def acknowledge(ids, reason, unack, now, since):
    """--ack and --unack. Root only, so nothing running as the desktop user
    can silence a red. Each acknowledgement records every file of the item in
    the state it is in now, and is noted in the journal."""
    if os.geteuid() != 0:
        print("spycatcher-report: acknowledging needs root: sudo spycatcher-report --ack ...",
              file=sys.stderr)
        return 2
    acks = load_acks()
    if unack:
        kept = [x for x in acks if x.get("id") != unack]
        if len(kept) == len(acks):
            print(f"spycatcher-report: no acknowledgement {unack}", file=sys.stderr)
            return 1
        write_acks(kept)
        subprocess.run(["logger", "-t", "spycatcher-report", f"acknowledgement {unack} removed"],
                       check=False)
        print(f"removed {unack}")
        return 0
    if not reason or not reason.strip():
        print("spycatcher-report: say what was checked: --reason \"...\"", file=sys.stderr)
        return 2
    integrity(now, since)
    # "amber" stands for every open amber item with no file in a sensitive
    # folder: a first check after an upgrade can list many folders of files
    # the upgrade removed. Reds, and ambers in sensitive folders, are
    # acknowledged one by one.
    if "amber" in ids:
        ids = [i for i in ids if i != "amber"] + sorted(AMBER_GROUPS)
    missing = [i for i in ids if i not in FOUND_GROUPS]
    if missing:
        print(f"spycatcher-report: no open item {', '.join(missing)}; "
              "run spycatcher-report to see the current IDs", file=sys.stderr)
        return 1
    by = os.environ.get("SUDO_USER") or "root"
    for i in ids:
        paths = {path: file_state(path) for path in FOUND_GROUPS[i]}
        # What the acknowledgement covers, by folder, so nothing unexpected
        # rides along with the files that were checked.
        folders = {}
        for path in paths:
            folders[os.path.dirname(path)] = folders.get(os.path.dirname(path), 0) + 1
        for folder, n in sorted(folders.items(), key=lambda kv: -kv[1])[:15]:
            print(f"  {i}: {n:>6} in {plain(folder)}")
        if len(folders) > 15:
            print(f"  {i}: and {len(folders) - 15} more folder(s)")
        acks.append({"id": i, "when": now.isoformat(), "by": by, "reason": plain(reason.strip()),
                     "paths": paths})
        subprocess.run(["logger", "-t", "spycatcher-report",
                        f"{by} acknowledged {i} ({len(paths)} file(s)): {plain(reason.strip())}"],
                       check=False)
        print(f"acknowledged {i}: {len(paths)} file(s)")
    write_acks(acks)
    return 0


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--days", type=int, default=7,
                    help="look back N days, at least 1 (default 7)")
    ap.add_argument("--plain", action="store_true")
    ap.add_argument("--all", action="store_true", help="list green items too")
    ap.add_argument("--html", metavar="FILE")
    ap.add_argument("--status", action="store_true", help="print only the overall rating")
    ap.add_argument("--json", action="store_true", help="machine-readable output")
    # For spycatcher-scan, so the scan and this report read install scripts
    # with one parser. Prints the resolved target, or exits 1.
    ap.add_argument("--scriptlet-link-target", nargs=2, metavar=("SCRIPT", "LINK"),
                    help=argparse.SUPPRESS)
    # For spycatcher-scan: checks a link listed in scan.conf's SCRIPTLET_LINKS.
    # Prints the package, or exits 1.
    ap.add_argument("--listed-link", nargs=2, metavar=("CONF", "LINK"), help=argparse.SUPPRESS)
    # For spycatcher-scan: checks a file whose install script gives it a group
    # and the setgid bit. Prints the package, or exits 1.
    ap.add_argument("--scriptlet-setgid", metavar="PATH", help=argparse.SUPPRESS)
    # For spycatcher-scan: exits 0 when a changed boot file is only
    # limine-snapper-sync's snapshot bookkeeping, see limine_snapshot_change.
    ap.add_argument("--limine-snapshot-change", nargs=3, metavar=("PATH", "REFERENCE", "SINCE"),
                    help=argparse.SUPPRESS)
    # For spycatcher-scan: reads owner and path pairs, each "OWNER\x1fPATH\0",
    # on standard input, so no path reaches a command line, and prints
    # "PATH\x1fREASON\0" for each file explain_changes() explains.
    ap.add_argument("--explain-changes", nargs=2, metavar=("CONF", "PACMAN_LOG"),
                    help=argparse.SUPPRESS)
    # For spycatcher-scan: exits 0 when /usr/lib/modules/VERSION belongs to a
    # kernel that is no longer installed, see old_kernel_modules.
    ap.add_argument("--old-kernel-modules", metavar="VERSION", help=argparse.SUPPRESS)
    ap.add_argument("--ack", nargs="+", metavar="ID",
                    help="as root: record AIDE items as checked, with --reason; "
                         "'amber' stands for every open amber item")
    ap.add_argument("--reason", metavar="TEXT", help="why the items in --ack are harmless")
    ap.add_argument("--unack", metavar="ID", help="as root: remove an acknowledgement")
    ap.add_argument("--acks", action="store_true", help="list acknowledgements")
    # For spycatcher-scan: prints the AIDE logs that still hold a red nobody
    # has acknowledged, one per line, which pruning keeps.
    ap.add_argument("--keep-logs", action="store_true", help=argparse.SUPPRESS)
    a = ap.parse_args()
    if a.days < 1:
        ap.error("--days must be at least 1")
    global _QKK_CACHE, _PACMAN_CACHE
    _QKK_CACHE, _PACMAN_CACHE = {}, {}

    if a.explain_changes:
        conf, log_path = a.explain_changes
        try:
            log = Path(log_path).read_text(errors="replace")
        except OSError:
            log = ""
        records = []
        for rec in sys.stdin.buffer.read().split(b"\0"):
            owner, sep, path = rec.decode(errors="surrogateescape").partition("\x1f")
            # The answer is "PATH\x1fGRADE\x1fREASON", so a path holding a
            # field separator or a control character could be read back as
            # another path. The scan never sends one; skip it all the same.
            if sep and path.startswith("/") and not _UNSAFE_CHARS.search(path + owner) and "\t" not in path:
                records.append((owner, path))
        out = sys.stdout.buffer
        for path, grade, reason in explain_changes(records, conf, log):
            out.write(f"{path}\x1f{grade}\x1f{plain(reason)}\0".encode(errors="surrogateescape"))
        return 0

    if a.old_kernel_modules:
        return 0 if old_kernel_modules(a.old_kernel_modules) else 1

    if a.listed_link:
        conf, link = a.listed_link
        pkg = listed_link_package(link, listed_links(conf))
        if pkg is None:
            return 1
        print(pkg)
        return 0

    if a.scriptlet_setgid:
        pkg = scriptlet_setgid(a.scriptlet_setgid)
        if pkg is None:
            return 1
        print(pkg)
        return 0

    if a.limine_snapshot_change:
        path, reference, since = a.limine_snapshot_change
        try:
            ok = limine_snapshot_change(path, reference, int(since))
        except ValueError:
            ok = False
        return 0 if ok else 1

    if a.scriptlet_link_target:
        script, link = a.scriptlet_link_target
        try:
            want = scriptlet_link_target(Path(script).read_text(), link)
        except (OSError, UnicodeDecodeError):
            want = None
        if want is None:
            return 1
        print(want)
        return 0

    now = dt.datetime.now().replace(microsecond=0)
    since = now - dt.timedelta(days=a.days)

    if a.acks:
        for rec in load_acks():
            print(f"{rec.get('id', '?')}  {str(rec.get('when', '?'))[:16].replace('T', ' ')}  "
                  f"{rec.get('by', '?')}  {len(rec['paths'])} file(s)  {plain(rec.get('reason', ''))}")
        return 0
    if a.keep_logs:
        integrity(now, since)
        for p in sorted(OPEN_RED_LOGS):
            print(p)
        return 0
    if a.ack or a.unack:
        return acknowledge(a.ack or [], a.reason, a.unack, now, since)

    try:
        reg = tomllib.loads(REGISTER.read_text())
    except (OSError, tomllib.TOMLDecodeError) as err:
        print(f"spycatcher-report: cannot read {REGISTER}: {err}", file=sys.stderr)
        reg = {}

    sections = [
        scan_health(now, since),
        packages(now, since, reg, installed_versions()),
        integrity(now, since),
        rootkit(now, since),
        models(now, since),
        secrets(now, since, reg),
        hardening(now, since),
        standing(reg),
        privacy(now, reg),
    ]
    overall = overall_of(sections)

    if a.json:
        print(json.dumps({
            "overall": overall,
            "line": overall_line(overall, sections),
            "start": since.isoformat(),
            "end": now.isoformat(),
            "sections": [{
                "title": plain(s.title), "rating": s.rating, "headline": plain(s.headline),
                "items": [{"rating": r, "what": w, "detail": d, "action": act}
                          for r, w, d, act in sorted(s.items, key=lambda i: -ORDER[i[0]])],
            } for s in sections],
        }))
    elif a.status:
        print(f"{LABEL[overall]}: {overall_line(overall, sections)}")
    elif a.html:
        try:
            write_private(Path(a.html), html_report(sections, overall, since, now))
        except OSError as err:
            print(f"spycatcher-report: cannot write {a.html}: {err}", file=sys.stderr)
            return 2
        print(a.html)
    else:
        print(text_report(sections, overall, since, now, colour=not a.plain and sys.stdout.isatty(), show_all=a.all))
    return {GREY: 0, GREEN: 0, AMBER: 0, RED: 1}[overall]


if __name__ == "__main__":
    sys.exit(main())
