# Settings for spycatcher-scan, installed as /etc/spycatcher/scan.conf.
#
# This file is sourced by a script that runs as root, so it must be owned by
# root and not writable by anyone else; spycatcher-scan ignores it otherwise.
# The installer fills in @USER@ and @HOME@ from the account that ran sudo.
# A variable set in the environment overrides the value here for that run.

# The account that receives desktop notifications and may read the logs in
# /var/log/spycatcher. The scans refuse to run without it rather than
# guess, because a guess could notify the wrong person.
DESKTOP_USER="@USER@"

# gitleaks scans every git repository at most two levels below this folder.
SCAN_ROOT="@HOME@/Work"

# Folders searched for pickle-format AI model files, separated by spaces.
# Folders that do not exist are skipped, so it is safe to list ones you may
# create later.
MODEL_ROOTS="@HOME@/AI @HOME@/.cache/huggingface"

# Symlinks that a package's install script points at a file it picks at run
# time, such as the build for this CPU or graphics card, as link=package
# pairs separated by spaces or new lines. AIDE reports a listed link as a
# package change only while it is a symlink to a file of that package, pacman
# finds that file unaltered, and the package's install script has an ln -s
# command for that exact path. Anything else at that path stays red. Write
# the value out in full; a variable or command in it empties the list. Read
# only from this file, never the environment. Empty by default. For example:
# SCRIPTLET_LINKS="/usr/bin/voxtype=voxtype-bin /usr/lib/voxtype/voxtype-onnx-cuda=voxtype-bin"
SCRIPTLET_LINKS=""

# Package files that a pacman hook of this machine's own, in
# /etc/pacman.d/hooks, patches after every upgrade of the package, as
# file=hook:sha256 entries separated by spaces or new lines: the hook by its
# file name, and the SHA-256 of the file as patched (sha256sum FILE), or
# several separated by commas. AIDE reports a listed file as a package change
# only while its content has one of those sums, the hook file is there, owned
# by root and writable by no one else, pacman finds nothing wrong with the
# file but its content, and the file was last changed within a minute of
# pacman.log recording that hook running. A patch applied any other way,
# other content, or a later edit stays red, and so does the file after an
# upgrade changes it, until its new sum is added. Write the value out in
# full; a variable or command in it empties the list. Read only from this
# file, never the environment. Empty by default. For example:
# HOOK_PATCHED="/usr/share/app/View.qml=app-view-fix.hook:<64 hex digits>"
HOOK_PATCHED=""
