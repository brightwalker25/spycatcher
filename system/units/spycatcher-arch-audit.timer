[Unit]
Description=Daily CVE check of installed packages (arch-audit)

[Timer]
Unit=spycatcher@arch-audit.service
OnCalendar=daily
# Spread the hit on the Arch security tracker, and don't fire mid-login.
RandomizedDelaySec=2h
# Catch up after the machine has been off or asleep through the scheduled time.
Persistent=true

[Install]
WantedBy=timers.target
