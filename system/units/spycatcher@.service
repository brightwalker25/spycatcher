[Unit]
Description=Spycatcher scan (%i)
Documentation=file:/usr/local/bin/spycatcher-scan
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/spycatcher-scan %i
TimeoutStartSec=45min

# Background work: never compete with the desktop for CPU or disk.
Nice=10
IOSchedulingClass=idle
CPUSchedulingPolicy=idle

# Light hardening only. lynis audits the whole system and arch-audit needs the
# network, so anything stricter than this breaks the scans it is protecting.
NoNewPrivileges=false
PrivateTmp=true
ProtectHome=read-only
ProtectControlGroups=true
ProtectKernelLogs=false
RestrictSUIDSGID=false
